      parameter Boolean positivegain = true;
      parameter Boolean header = true;
      parameter Real Ki = 1 "Ki = Kp/Ti";
      parameter Real Kp = 1 "Kp = mu";
      parameter Real Kd = 1 "Kd = Kp*Td";
      parameter Real yMax = 100;
      parameter Real yMin = 0;
      Real x(start = 0);
      Real e, up, ui;
    equation
//  pid.u_s = if noEvent(positivegain == true) then y_set else y;
//  pid.u_m = if noEvent(positivegain == true) then y else y_set;
//u = if noEvent(bool_constraint == true) then pid.y else 1;
//bool_constraint == true mean y_constraint<y_constraint_max
//I have to introduce a PI calculation. If bool_constriant is true, u = calculated from pid block, else u = calculated from  the new state as a function of u_other
//If this block is the selector "header" and bool_contraint true, output from PI, else u_other. And viceversa if "header" is false.
//if noEvent(header == bool_constraint) then
//der(x)=e;
//else
//x = (u_other - Kp*e)/Ki;
//end if;
//  der(x) = e;
//  u = max(yMin, min(yMax, Kp*e + Ki*x));
//
      x + Kp/Ki*der(x) = u;
      up = Kp*e;
      ui = x;
      u = max(yMin, min(yMax, ui + up));
//  u = max(yMin,min(yMax,x+Kp*e));
//
      e = if noEvent(positivegain == true) then y_set - y else y - y_set;
//  x = if noEvent(header == bool_constraint) then pid.I.y else (u_other - Kp*e - Kd*der(e))/Ki;
//  connect(pid.y, u) annotation(
//    Line(points = {{10, 2}, {92, 2}, {92, -2}}, color = {0, 0, 127}));
//initial equation
//if noEvent(header == true) then
//u = 0;
//else
//der(x)=0;
//end if;
    end Selector_Leva;

