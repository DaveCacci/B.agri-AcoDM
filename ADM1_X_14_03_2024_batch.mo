  model UIT_real_CL_selector_ratio_mine_withoutZOH
    //TO DO 21.01.2024
    // > gasbag buffering effect on ch4/co2 ratio
    // > onminutes spread uniformely in control interval
    // > try it with variable setpoint/treshold
    //
    UIT_OL uit_ol(impulse = true, real = false, uit(q(start = {0.24*4e-4, (1 - 0.24)*(1 - 0.4)*4e-4, (1 - 0.24)*0.4*4e-4, 0, 0}))) annotation(
      Placement(visible = true, transformation(origin = {90, 0}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    ADM1_P.Control.Switch switch annotation(
      Placement(visible = true, transformation(origin = {52, -2}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Control.Selector_3 header(Kd = 0, Ki = 1e-7, Kp = 1e-2, header = true, yMin = -95/1e6) annotation(
      Placement(visible = true, transformation(origin = {-70, 48}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //  Modelica.Blocks.Sources.Step y1_set(height = 0.023, startTime = 1e6) annotation(
    //    Placement(visible = true, transformation(origin = {-136, 48}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Control.Selector_3 follower(Kd = 0, Ki = 1e-7, Kp = 1e-2, header = false, positivegain = true, yMin = -95/1e6) annotation(
      Placement(visible = true, transformation(origin = {-70, -62}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    ADM1_P.Control.HysteresisComparator hysteresisComparator(pre_y_start = true, uHigh = 1/1, uLow = 1/1.05) annotation(
      Placement(visible = true, transformation(origin = {2, -2}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Boolean not_u = not hysteresisComparator.y;
    Real y1_set;
    parameter Real height_y1_set = 0.5;
    parameter Real duration_y1_set = 1e6;
    parameter Real Tc = 2.5*3600 "";
    Real tfr;
    parameter Real actuator_min_flowrate(unit = "mL/min") = 10;
    Real on_minutes;
    Real off_minutes;
    Real on_minutes_fake;
    Modelica.Blocks.Sources.Ramp y2_set(duration(displayUnit = "Ms") = 1000000, height = 0, offset = 1/1.18198, startTime(displayUnit = "Ms") = 1000000) annotation(
      Placement(visible = true, transformation(origin = {-118, -62}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
  equation
// Methane flowrate output connection to PI controller
    uit_ol.y[1] = header.y;
// CO2/CH4 gas ratio output connection to PI controller
    1/uit_ol.division.y = follower.y;
// CO2/CH4 gas ratio outout connection to "comparator"
    hysteresisComparator.u = 1/uit_ol.division.y;
// Methane flowrate setpoint
    y1_set = if time < 1e6 then 0 else if time < (1e6 + duration_y1_set) then (time - 1e6)*height_y1_set/duration_y1_set else height_y1_set;
    header.y_set = y1_set;
// Reinizialization of the two PIs
    when noEvent(edge(hysteresisComparator.y)) then
      reinit(follower.x, (follower.u_other - follower.Kp*follower.e)/follower.Ki);
    end when;
    when noEvent(edge(not_u)) then
      reinit(header.x, (header.u_other - header.Kp*header.e)/header.Ki);
    end when;
// Impulse conversion of the control action (on/off actuators)
//If switch.y is in L/h
    when sample(0, Tc) then
      tfr = time;
//from m3/day to L/h
//Ti shall be in minutes to be rounded to the nearest integer
      on_minutes_fake = switch.y*1e6/(24*60*60)*Tc/actuator_min_flowrate;
      on_minutes = ADM1_P.Functions.round(switch.y*1e6/(24*60*60)*Tc/actuator_min_flowrate);
      off_minutes = if noEvent(on_minutes <= 0) then 0 else (Tc - on_minutes)/on_minutes;
    end when;
    if time > 1e6 and (time - tfr) < on_minutes*60 + 60 then
      if time - tfr < 60 then
        uit_ol.u = {0, 0, 0, 0, 0};
      else
        uit_ol.u = {actuator_min_flowrate/1e6*24*60, 0, 0, 0, 0};
      end if;
    elseif on_minutes < 0 and (time - tfr) < 60 then
      uit_ol.u = {-actuator_min_flowrate/1e6*24*60 + 1e-7, 0, 0, 0, 0};
    else
      uit_ol.u = {0, 0, 0, 0, 0};
    end if;
// Buffer ch4/co2 high frequencies with a FIR filter or gasbag
//    fir1.u = follower.y;
// Add nominal pump_feeding_interval (19.01.2024 now it is an input to allow variability in UIT_OL_optim_19_01)
    uit_ol.pump_feeding_interval = 2.5*3600;
//
// Connections
    connect(follower.u, header.u_other) annotation(
      Line(points = {{-60, -62}, {-52, -62}, {-52, 34}, {-88, 34}, {-88, 52}, {-78, 52}}, color = {0, 0, 127}));
    connect(header.u, follower.u_other) annotation(
      Line(points = {{-60, 48}, {-46, 48}, {-46, -36}, {-78, -36}, {-78, -58}}, color = {0, 0, 127}));
//  connect(y1_set.y, header.y_set) annotation(
//    Line(points = {{-124, 48}, {-80, 48}}, color = {0, 0, 127}));
    connect(hysteresisComparator.y, switch.u2) annotation(
      Line(points = {{14, -2}, {40, -2}}, color = {255, 0, 255}));
    connect(header.bool_constraint, hysteresisComparator.y) annotation(
      Line(points = {{-78, 42}, {-94, 42}, {-94, 24}, {14, 24}, {14, -2}}, color = {255, 0, 255}));
    connect(follower.bool_constraint, hysteresisComparator.y) annotation(
      Line(points = {{-78, -68}, {-90, -68}, {-90, -82}, {14, -82}, {14, -2}}, color = {255, 0, 255}));
    connect(y2_set.y, follower.y_set) annotation(
      Line(points = {{-107, -62}, {-80, -62}}, color = {0, 0, 127}));
    connect(header.u, switch.u3) annotation(
      Line(points = {{-60, 48}, {40, 48}, {40, -10}}, color = {0, 0, 127}));
    connect(follower.u, switch.u1) annotation(
      Line(points = {{-60, -62}, {40, -62}, {40, 6}}, color = {0, 0, 127}));
    annotation(
      experiment(StartTime = 0, StopTime = 5.184e+06, Tolerance = 1e-06, Interval = 3600),
      __OpenModelica_commandLineOptions = "--matchingAlgorithm=PFPlusExt --indexReductionMethod=dynamicStateSelection -d=initialization,NLSanalyticJacobian --std=latest ",
      __OpenModelica_simulationFlags(lv = "LOG_STATS", s = "dassl", variableFilter = ".*"),
      Diagram);
  end UIT_real_CL_selector_ratio_mine_withoutZOH;

