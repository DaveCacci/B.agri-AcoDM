  model Identification_discrete_meas
    //Measurments from sapling or combiTimeTable?
    parameter Boolean combi = true;
    //Measurments from sampling
    parameter Real Ts = 5;
    parameter Integer n_sample = 20 "round(simulation_time/Ts)-1";
    //Measurments from combiTimeTable
    parameter Real meas[36, 3] = [1, 86400, 172.1; 2, 172800, 220; 3, 259200, 246.7; 4, 345600, 249.4; 5, 432000, 252.1; 6, 518400, 259.6; 7, 604800, 279.7; 8, 691200, 315; 9, 777600, 370.3; 10, 864000, 472.9; 11, 950400, 645.1; 12, 1036800, 852.5; 13, 1123200, 1025.7; 14, 1209600, 1199.7; 15, 1296000, 1342.7; 16, 1382400, 1432.3; 17, 1468800, 1497; 18, 1555200, 1570.5; 19, 1641600, 1664.4; 20, 1728000, 1784.2; 21, 1814400, 1924.1; 22, 1900800, 2093.3; 23, 1987200, 2268.4; 24, 2073600, 2354.4; 25, 2160000, 2385.3; 26, 2246400, 2405.3; 27, 2332800, 2418.1; 28, 2419200, 2429.8; 29, 2505600, 2435.5; 30, 2592000, 2439.8; 31, 2678400, 2442.2; 32, 2764800, 2444.7; 33, 2851200, 2447.1; 34, 2937600, 2449.7; 35, 3024000, 2452.3; 36, 3110400, 2454.9];
    parameter Integer n_meas = size(combiTimeTable.table[2:end, :], 1);
    Real t_meas[n_meas] = meas[:, 2];
    Real v_meas[n_meas] = meas[:, 3];
    parameter Real table[37, 3] = [0, 0, 0; meas];
    //Parameters to be identified
    parameter Real mu = 266.856;
    parameter Real T = 0.1077115;
    //Variable declaration
    Real ISE(start = 0, fixed = true);
    Real ISE_cont(start = 0, fixed = true);
    Real obs(start = 1);
    Real MSE;
    Integer i_curr;
    Real err(start = 0, fixed = true);
    Modelica.Blocks.Sources.CombiTimeTable combiTimeTable(extrapolation = Modelica.Blocks.Types.Extrapolation.HoldLastPoint, smoothness = Modelica.Blocks.Types.Smoothness.ConstantSegments, table = table[:, 2:3]) annotation(
      Placement(visible = true, transformation(origin = {-186, 72}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    BMP_identification bMP_identification(beta = {39/86400, 40/(86400)^2}, alpha = {1, 7.8e-2/86400, 2.25e-2/(86400^2)}) annotation(
      Placement(visible = true, transformation(origin = {0, -2}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
  equation
    der(ISE_cont) = (bMP_identification.fixedDelay.y - combiTimeTable.y[1])^2;
    der(obs) = combiTimeTable.y[1]^2;
    MSE = 100*(1 - sqrt(ISE_cont/obs));
  initial algorithm
//ISE := 0;
    i_curr := 1;
//err :=0;
  algorithm
    when time >= t_meas[i_curr] then
      err := bMP_identification.fixedDelay.y - v_meas[i_curr];
      ISE := ISE + err^2;
//    MSE := ISE/n_meas;
      i_curr := i_curr + 1;
    end when;
    annotation(
      Diagram(coordinateSystem(extent = {{-200, -100}, {200, 100}})),
      experiment(StartTime = 0, StopTime = 3.1104e+06, Tolerance = 1e-06, Interval = 3600),
      uses(Modelica(version = "4.0.0")),
      __OpenModelica_commandLineOptions = "--matchingAlgorithm=PFPlusExt --indexReductionMethod=dynamicStateSelection -d=initialization,NLSanalyticJacobian --std=latest ",
      __OpenModelica_simulationFlags(lv = "LOG_STATS", s = "dassl", variableFilter = ".*"));
  end Identification_discrete_meas;

  model Sgo_identification
    Sgo_plant sgo_observed annotation(
      Placement(visible = true, transformation(origin = {-28, 2}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Sgo_plant sgo_estimated(digester.k_hyd_xprs = 0.5) annotation(
      Placement(visible = true, transformation(origin = {16, 2}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Real ISE(start = 0, fixed = true);
    Real ISE_cont(start = 0, fixed = true);
    Integer i_curr;
    Real err(start = 0, fixed = true);
  equation
    der(ISE_cont) = (sgo_observed.digester.TAN - sgo_estimated.digester.TAN)^2;
  initial algorithm
//ISE := 0;
    i_curr := 1;
//err :=0;
  algorithm
    when sample(0, 86400) then
      err := sgo_observed.digester.TAN - sgo_estimated.digester.TAN;
      ISE := ISE + err^2;
      i_curr := i_curr + 1;
    end when;
    annotation(
      experiment(StartTime = 0, StopTime = 8.4672e+06, Tolerance = 1e-06, Interval = 3600),
      __OpenModelica_commandLineOptions = "--matchingAlgorithm=PFPlusExt --indexReductionMethod=dynamicStateSelection -d=initialization,NLSanalyticJacobian --std=latest ",
      __OpenModelica_simulationFlags(lv = "LOG_STATS", s = "dassl", variableFilter = ".*"));
  end Sgo_identification;

