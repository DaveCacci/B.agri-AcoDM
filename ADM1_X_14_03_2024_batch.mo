  model Sensitivity_Sobol_UIT_selector_withoutZOH
    //Set up on 11.12.2023 for "UIT_real_CL_selector_ratio_mine" UIT selector controller
    //Compute QoI
    //Real xch4_min(start=1);
    Real ISE_e(start = 0);
    Real ISE_u(start = 0);
    //Parameters to be modified
    //Nominal parameter values
    parameter Real Ti1 = 1e5;
    parameter Real Ti2 = 1e5 "Ki = kp/Ti";
    parameter Real kp1 = 0.005;
    parameter Real kp2 = 0.01;
    parameter Real height_y1_set = 0;
    //0.1;
    parameter Real duration_y1_set = 2e6;
    //2e6;
    parameter Real height_y2_set = 1/1.17926;
    //1.18198;
    parameter Real hyst_uLow = 1/1.1;
    //1/1.05
    parameter Real hyst_uHigh = 1/0.95;
    //1
    //Process parameters
    parameter Real k_hyd_xchr = 1;
    parameter Real k_hyd_xchm = 0.3;
    parameter Real k_hyd_xchs = 0.01;
    parameter Real k_hyd_xprr = 1;
    parameter Real k_hyd_xprs = 0.2;
    parameter Real k_hyd_xli = 0.3;
    parameter Real k_m_su = 11;
    parameter Real k_m_aa = 10;
    parameter Real k_m_c4 = 14;
    parameter Real k_m_pro = 13;
    parameter Real k_m_ac = 5.6;
    parameter Real Ks_ac = 0.15;
    parameter Real Ki_nh3_ac = 0.0018;
    //0.0018  0.0071428571;
    parameter Real Ki_hac_ac = 2.2;
    parameter Real Ki_hpro_pro = 2.2;
    parameter Real kla = 10;
    parameter Boolean impulse = true;
    //Set input fractioning: Do the sensitivity as a fuction of feed_ratio and liquidcontrol_ratio?
    //
    UIT_real_CL_selector_ratio_mine_withoutZOH selector(uit_ol.impulse = impulse, uit_ol.uit.digester.X_su_start = 2.45026, uit_ol.uit.digester.X_aa_start = 0.642099, uit_ol.uit.digester.X_fa_start = 0.217664, uit_ol.uit.digester.X_c4_start = 0.484566, uit_ol.uit.digester.X_pro_start = 0.300024, uit_ol.uit.digester.X_ac_start = 1.2262, uit_ol.uit.digester.X_h2_start = 0.583586, uit_ol.uit.digester.X_c_start = 0, uit_ol.uit.digester.X_i_start = 30.2866, uit_ol.uit.digester.X_ch_start = {1.01714, 0.961277, 3.56827}, uit_ol.uit.digester.X_pr_start = {0.277166, 0.849485}, uit_ol.uit.digester.X_li_start = 0.680653, uit_ol.uit.digester.X_p_start = 0.441202, uit_ol.uit.digester.S_i_start = 0.110301, uit_ol.uit.digester.S_su_start = 0.031265, uit_ol.uit.digester.S_aa_start = 0.0331616, uit_ol.uit.digester.S_fa_start = 0.0600327, uit_ol.uit.digester.S_va_start = 0.00515174, uit_ol.uit.digester.S_bu_start = 0.00886531, uit_ol.uit.digester.S_pro_start = 0.0697662, uit_ol.uit.digester.S_ac_start = 0.240605, uit_ol.uit.digester.S_h2_start = 8.68436e-07, uit_ol.uit.digester.S_ch4_start = 0.317367, uit_ol.uit.digester.S_ic_start = 0.212487, uit_ol.uit.digester.S_in_start = 0.128729, uit_ol.uit.digester.S_ip_start = 0.00309532, uit_ol.uit.digester.S_cat_start = 0.101077, uit_ol.uit.digester.S_ca_start = 4.98125e-05, uit_ol.uit.digester.S_mg_start = 0.000137233, uit_ol.uit.digester.S_an_start = 0.01696, uit_ol.uit.digester.ash_start = 14.2056, uit_ol.uit.digester.X_lig_start = 8.82497, uit_ol.uit.digester.S_gas_h2_start = 5.81582e-06, uit_ol.uit.digester.S_gas_ch4_start = 1.26012, uit_ol.uit.digester.S_gas_co2_start = 0.0166964, uit_ol.uit.digester.S_gas_nh3_start = 2.13683e-06, uit_ol.uit.digester.X_acp_start = 1.43722e-11, uit_ol.uit.digester.X_stru_start = 0.00934901, uit_ol.uit.digester.X_ccm_start = 0.00499019, uit_ol.uit.digester.X_mag_start = 4.01861e-09, uit_ol.uit.limPID.xi_start = 0.0276888, uit_ol.Qch4_bar.k = 0.455709, uit_ol.gasquality_bar.k = 1.17926, uit_ol.pH_bar.k = 7.3316, uit_ol.uit.digester.k_hyd_xchr = k_hyd_xchr, uit_ol.uit.digester.k_hyd_xchm = k_hyd_xchm, uit_ol.uit.digester.k_hyd_xchs = k_hyd_xchs, uit_ol.uit.digester.k_hyd_xprr = k_hyd_xprr, uit_ol.uit.digester.k_hyd_xprs = k_hyd_xprs, uit_ol.uit.digester.k_hyd_xli = k_hyd_xli, uit_ol.uit.digester.k_m_su = k_m_su, uit_ol.uit.digester.k_m_aa = k_m_aa, uit_ol.uit.digester.k_m_c4 = k_m_c4, uit_ol.uit.digester.k_m_pro = k_m_pro, uit_ol.uit.digester.k_m_ac = k_m_ac, uit_ol.uit.digester.Ks_ac = Ks_ac, uit_ol.uit.digester.Ki_nh3_ac = Ki_nh3_ac, uit_ol.uit.digester.Ki_hac_ac = Ki_hac_ac, uit_ol.uit.digester.Ki_hpro_pro = Ki_hpro_pro, header.Ki = kp1/Ti1, follower.Ki = kp2/Ti2, header.Kp = kp1, follower.Kp = kp2, hysteresisComparator.uLow = hyst_uLow, hysteresisComparator.uHigh = hyst_uHigh, height_y1_set = height_y1_set, duration_y1_set = duration_y1_set, y2_set.offset = height_y2_set);
  equation
//Objective function for minimization of the tracking error of methane production
    der(ISE_e) = (selector.y1_set - selector.uit_ol.Qch4.y)^2;
    der(ISE_u) = selector.uit_ol.uit.q[1];
    annotation(
      experiment(StartTime = 0, StopTime = 5.184e+06, Tolerance = 1e-06, Interval = 3600),
      __OpenModelica_commandLineOptions = "--matchingAlgorithm=PFPlusExt --indexReductionMethod=dynamicStateSelection -d=initialization,NLSanalyticJacobian --std=latest ",
      __OpenModelica_simulationFlags(lv = "LOG_STATS", s = "dassl", variableFilter = ".*"));
  end Sensitivity_Sobol_UIT_selector_withoutZOH;

