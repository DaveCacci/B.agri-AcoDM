    Sensitivity_Sobol_UIT_selector normal(duration_y1_set = 2e6, height_y1_set = 0.5) annotation(
      Placement(visible = true, transformation(origin = {-34, 44}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Sensitivity_Sobol_UIT_selector equilibrium(height_y1_set = 0, duration_y1_set = 2e6) annotation(
