    connect(add3.y, uit.q[3]) annotation(
      Line(points = {{0, -6}, {26, -6}, {26, 50}}, color = {0, 0, 127}));
    connect(feedback1.y, limIntegrator.u) annotation(
      Line(points = {{-203, 50}, {-195, 50}}, color = {0, 0, 127}));
    connect(step_dig.y, feedback1.u1) annotation(
      Line(points = {{-251, 50}, {-221, 50}}, color = {0, 0, 127}));
    connect(gain.u, limIntegrator.y) annotation(
      Line(points = {{-162, 50}, {-171, 50}}, color = {0, 0, 127}));
    connect(step_gas.y, feedback.u1) annotation(
      Line(points = {{-249, 4}, {-249, 2}, {-219, 2}}, color = {0, 0, 127}));
    connect(gain.y, add.u1) annotation(
      Line(points = {{-139, 50}, {-22, 50}, {-22, 56}}, color = {0, 0, 127}));
    connect(feedback.y, transferFunction1.u) annotation(
      Line(points = {{-200, 2}, {-182, 2}, {-182, 0}}, color = {0, 0, 127}));
    connect(transferFunction1.y, add3.u1) annotation(
      Line(points = {{-158, 0}, {-24, 0}}, color = {0, 0, 127}));
    connect(gain1.u, limIntegrator1.y) annotation(
      Line(points = {{-164, -72}, {-173, -72}}, color = {0, 0, 127}));
    connect(feedback3.y, transferFunction.u) annotation(
      Line(points = {{-203, -120}, {-185, -120}, {-185, -122}}, color = {0, 0, 127}));
    connect(feedback2.y, limIntegrator1.u) annotation(
      Line(points = {{-205, -72}, {-197, -72}}, color = {0, 0, 127}));
    connect(gain1.y, uIT_linear.u[2]) annotation(
      Line(points = {{-140, -72}, {14, -72}, {14, -98}}, color = {0, 0, 127}));
    connect(transferFunction.y, uIT_linear.u[3]) annotation(
      Line(points = {{-160, -122}, {14, -122}, {14, -98}}, color = {0, 0, 127}));
    connect(feedback2.u2, uIT_linear.y[5]) annotation(
      Line(points = {{-214, -64}, {-214, -54}, {60, -54}, {60, -98}, {34, -98}}, color = {0, 0, 127}));
    connect(uIT_linear.y[4], feedback3.u2) annotation(
      Line(points = {{34, -98}, {60, -98}, {60, -136}, {-212, -136}, {-212, -128}}, color = {0, 0, 127}));
    connect(Qch4.y, feedback.u2) annotation(
      Line(points = {{100, 64}, {116, 64}, {116, -18}, {-210, -18}, {-210, -6}}, color = {0, 0, 127}));
    connect(pH.y, feedback1.u2) annotation(
      Line(points = {{100, 34}, {116, 34}, {116, 98}, {-212, 98}, {-212, 58}}, color = {0, 0, 127}));
    connect(step_dig.y, feedback2.u1) annotation(
      Line(points = {{-250, 50}, {-236, 50}, {-236, -72}, {-222, -72}}, color = {0, 0, 127}));
    connect(step_gas.y, feedback3.u1) annotation(
      Line(points = {{-248, 4}, {-250, 4}, {-250, -120}, {-220, -120}}, color = {0, 0, 127}));
    annotation(
      experiment(StartTime = 0, StopTime = 6.32448e+07, Tolerance = 1e-06, Interval = 3600),
      __OpenModelica_commandLineOptions = "--matchingAlgorithm=PFPlusExt --indexReductionMethod=dynamicStateSelection -d=initialization,NLSanalyticJacobian --std=latest ",
      __OpenModelica_simulationFlags(lv = "LOG_STATS", s = "dassl", variableFilter = ".*"),
      Diagram);
  end UIT_CL_L_NL;

  model Multiple_UIT_OL_explore
    //Delete "pulse" block to speed up the simulation
    parameter Real feed_ratio = 0.2 "(Qpalpable-Qcontrol)/(Qpalpable-Qcontrol+Qslurry)";
    parameter Real liquidcontrol_ratio = 0.24 "Qcontrol/Qtot. Set from 15%OLR of s.Antonio OLR";
    //
    Real tfr(start = 0), tfr1(start = 0);
    //Declare multiple to test different pulse periods
    //
    //"Nominal" simulation
    UIT_OL uit_ol_01_step(feed_ratio = feed_ratio, liquidcontrol_ratio = liquidcontrol_ratio, ramp_tomato.height = 0.2*liquidcontrol_ratio*4e-4, ramp_slurry.height = 0.2*(1 - feed_ratio)*(1 - liquidcontrol_ratio)*4e-4, ramp_maize.height = 0.2*feed_ratio*(1 - liquidcontrol_ratio)*4e-4, impulse = true, uit.digester.Ki_nh3_ac = 0.0018) annotation(
      Placement(visible = true, transformation(origin = {-66, 58}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    UIT_OL uit_ol_01_tomatostep_01_pulses(feed_ratio = feed_ratio, liquidcontrol_ratio = liquidcontrol_ratio, ramp_tomato.height = 0.2*liquidcontrol_ratio*4e-4, ramp_slurry.height = 0.2*(1 - feed_ratio)*(1 - liquidcontrol_ratio)*4e-4, ramp_maize.height = 0.2*feed_ratio*(1 - liquidcontrol_ratio)*4e-4, impulse = true, uit.digester.Ki_nh3_ac = 0.0018) annotation(
      Placement(visible = true, transformation(origin = {-66, 58}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    UIT_OL uit_ol_sines(feed_ratio = feed_ratio, liquidcontrol_ratio = liquidcontrol_ratio, sin_tomato.constantAmplitude = 0.2*liquidcontrol_ratio*4e-4, sin_slurry.constantAmplitude = 0.2*(1 - feed_ratio)*(1 - liquidcontrol_ratio)*4e-4, sin_maize.constantAmplitude = 0.2*feed_ratio*(1 - liquidcontrol_ratio)*4e-4, sin_tomato.constantFrequency = 1e-6, sin_slurry.constantFrequency = 1e-7, sin_maize.constantFrequency = 1e-5, impulse = true, uit.digester.Ki_nh3_ac = 0.0018) annotation(
      Placement(visible = true, transformation(origin = {-66, 58}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    UIT_OL uit_ol_01_ramps(feed_ratio = feed_ratio, liquidcontrol_ratio = liquidcontrol_ratio, ramp_tomato.height = 0.2*liquidcontrol_ratio*4e-4, ramp_slurry.height = 0.2*(1 - feed_ratio)*(1 - liquidcontrol_ratio)*4e-4, ramp_maize.height = 0.2*feed_ratio*(1 - liquidcontrol_ratio)*4e-4, ramp_tomato.duration = 2e6, ramp_maize.duration = 2e6, ramp_slurry.duration = 2e6, impulse = true, uit.digester.Ki_nh3_ac = 0.0018) annotation(
      Placement(visible = true, transformation(origin = {-66, 58}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //
    //  //Definion of additional imputs
    //  Modelica.Blocks.Sources.Exponentials exponentials(offset = 0, outMax = 1.2*0.9*0.12*4e-4, riseTime = 8e7, riseTimeConst = 1e6, startTime(displayUnit = "Ms") = 1000000) annotation(
    //    Placement(visible = true, transformation(origin = {-64, 10}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //  Modelica.Blocks.Sources.Exponentials exponentials_imp(offset = 0, outMax = 86400*5/300*1.2*0.9*0.12*4e-4, riseTime = 8e7, riseTimeConst = 1e6, startTime(displayUnit = "Ms") = 1000000) annotation(
    //    Placement(visible = true, transformation(origin = {-64, -24}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //  //Step change modifying substrate flowate (modifies both substrate ratios and HRT)
    //  Modelica.Blocks.Sources.Step step(height = 0.1*liquidcontrol_ratio*4e-4, startTime(displayUnit = "Ms") = 1000000) annotation(
    //    Placement(visible = true, transformation(origin = {-18, 12}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //  //Step change modifying substrate flowate (modifies only substrate ratios)
    //  Modelica.Blocks.Sources.Step step_plus(height = 9.6/1e6, startTime(displayUnit = "Ms") = 1000000) annotation(
    //    Placement(visible = true, transformation(origin = {-18, 12}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //  Modelica.Blocks.Sources.Step step_minus(height = -9.6/1e6, startTime(displayUnit = "Ms") = 1000000) annotation(
    //    Placement(visible = true, transformation(origin = {-18, 12}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //  //
    //  Modelica.Blocks.Sources.Pulse pulse(amplitude = 2.5e-5*86400/300, nperiod = 1, period(displayUnit = "s") = 86400, startTime(displayUnit = "Ms") = 1000000, width = 300/86400*100) annotation(
    //    Placement(visible = true, transformation(origin = {-18, -26}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //  Modelica.Blocks.Sources.Pulse pulse_silage(amplitude = 2*86400/300*feed_ratio*(1 - liquidcontrol_ratio)*4e-4, nperiod = -1, offset = -feed_ratio*(1 - liquidcontrol_ratio)*4e-4, period(displayUnit = "s") = 86400, startTime(displayUnit = "Ms") = 1000000, width = 300/(86400*2)*100) annotation(
    //    Placement(visible = true, transformation(origin = {-172, -24}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //  Modelica.Blocks.Sources.Pulse pulse_slurry(amplitude = 2*86400/300*(1 - feed_ratio)*(1 - liquidcontrol_ratio)*4e-4, nperiod = -1, offset = -(1 - feed_ratio)*(1 - liquidcontrol_ratio)*4e-4, period(displayUnit = "s") = 86400, startTime(displayUnit = "Ms") = 1000000, width = 300/(86400*2)*100) annotation(
    //    Placement(visible = true, transformation(origin = {-172, -24}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
  equation
//Set missing input
    uit_ol_01_step.u = {uit_ol_01_step.ramp_tomato.y, uit_ol_01_step.ramp_slurry.y, uit_ol_01_step.ramp_maize.y, 0, 0};
    uit_ol_01_ramps.u = {uit_ol_01_ramps.ramp_tomato.y, uit_ol_01_ramps.ramp_slurry.y, uit_ol_01_ramps.ramp_maize.y, 0, 0};
    uit_ol_01_tomatostep_01_pulses.u[1] = uit_ol_01_tomatostep_01_pulses.ramp_tomato.y;
    uit_ol_01_tomatostep_01_pulses.u[4] = 0;
    uit_ol_01_tomatostep_01_pulses.u[5] = 0;
    if time > 1e6 then
      uit_ol_sines.u[1] = uit_ol_sines.sin_tomato.y;
      uit_ol_sines.u[4] = 0;
      uit_ol_sines.u[5] = 0;
    else
      uit_ol_sines.u[1] = 0;
      uit_ol_sines.u[4] = 0;
      uit_ol_sines.u[5] = 0;
    end if;
//uit_ol_sines.u = {uit_ol_sines.sin_tomato.y, uit_ol_sines.sin_slurry.y, uit_ol_sines.sin_maize.y, 0, 0};
    if (time - tfr) < 300 and time > 1e6 then
      uit_ol_01_tomatostep_01_pulses.u[2] = 86400/300*uit_ol_01_tomatostep_01_pulses.ramp_slurry.y;
      uit_ol_01_tomatostep_01_pulses.u[3] = 86400/300*uit_ol_01_tomatostep_01_pulses.ramp_maize.y;
    else
      uit_ol_01_tomatostep_01_pulses.u[2] = 0;
      uit_ol_01_tomatostep_01_pulses.u[3] = 0;
    end if;
    if (time - tfr1) < 300 and time > 1e6 then
      uit_ol_sines.u[2] = 2*86400/300*uit_ol_sines.sin_slurry.y;
      uit_ol_sines.u[3] = 2*86400/300*uit_ol_sines.sin_maize.y;
    else
      uit_ol_sines.u[2] = 0;
      uit_ol_sines.u[3] = 0;
    end if;
//
//Always the same? Minimum sampling tine
    when sample(0, 86400) then
      tfr = time;
    end when;
    when sample(0, 2*86400) then
      tfr1 = time;
    end when;
    annotation(
      experiment(StartTime = 0, StopTime = 5.184e+06, Tolerance = 1e-06, Interval = 3600),
      __OpenModelica_commandLineOptions = "--matchingAlgorithm=PFPlusExt --indexReductionMethod=dynamicStateSelection -d=initialization,NLSanalyticJacobian --std=latest ",
      __OpenModelica_simulationFlags(lv = "LOG_STATS", s = "dassl", variableFilter = ".*"));
  end Multiple_UIT_OL_explore;

  model Multiple_UIT_OL_old
    //Set as 'old' on 28.11.2023
    //Delete "pulse" block to speed up the simulation
    parameter Real feed_ratio = 0.2 "(Qpalpable-Qcontrol)/(Qpalpable-Qcontrol+Qslurry)";
    parameter Real liquidcontrol_ratio = 0.24 "Qcontrol/Qtot. Set from 15%OLR of s.Antonio OLR";
    //
    //"Nominal" simulation
    UIT_OL uit_ol(feed_ratio = feed_ratio, liquidcontrol_ratio = liquidcontrol_ratio, uit.digester.Ki_nh3_ac = 0.0018) annotation(
      Placement(visible = true, transformation(origin = {-66, 58}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //"Real" UIT simulation
    ADM1_P.UIT_OL uit_ol_kla(feed_ratio = feed_ratio, liquidcontrol_ratio = liquidcontrol_ratio, uit.digester.kla = 10, uit.digester.Ki_hac_ac = 2, uit.digester.Ki_hpro_pro = 2, uit.digester.k_hyd_xchr = 0.2, uit.digester.k_hyd_xli = 0.1, uit.digester.k_hyd_xprr = 0.2, uit.digester.Ks_ac = 0.25, uit.digester.k_m_ac = 5, uit.digester.Ki_nh3_ac = 0.0018) annotation(
      Placement(visible = true, transformation(origin = {-12, 58}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
