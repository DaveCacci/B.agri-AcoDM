  model UIT_real_R1
    //22.02.2024: tomato feed taken from combi, manual flowrate combi is extended to control period, tomato COD as Ssu.
    //
    parameter Real feed_ratio = 0.2 "0.116, (Qpalpable-Qcontrol)/(Qpalpable-Qcontrol+Qslurry)";
    parameter Real liquidcontrol_ratio = 0.24 "0.26, Qcontrol/Qtot. Set from 15%OLR of s.Antonio OLR";
    parameter Real Qtot = 400 "370, Total input flowrate [mL/day]";
    parameter Boolean impulse = true;
    parameter Boolean real = true;
    parameter Real solid_feeding_interval = 2*86400;
    Real tfr;
    //Nominal biological parameters (calibation 13.01.2024 solo pilot)
    //Nominal parameter values
    //Add other Ks, Ki and kd!!
    parameter Real k_hyd_xchr = 0.45 "0.32566743895306743, 0.45, 1";
    parameter Real k_hyd_xchm = 0.28 "0.42319302147680693 0.28,0.3";
    parameter Real k_hyd_xchs = 0.011 "0.016324478692379397 0.011, 0.01";
    parameter Real k_hyd_xprr = 1.24 "0.7448677043180438 1.24, 1";
    parameter Real k_hyd_xprs = 0.19 "0.21758908555328108 0.19, 0.2";
    parameter Real k_hyd_xli = 0.449 "0.35010790985270795 0.449, 0.3";
    parameter Real k_m_su = 11 "7.875631490240984 11, 30";
    parameter Real k_m_aa = 10 "12.535480801087115 10, 50";
    parameter Real k_m_c4 = 14 "16.696872722083715 14, 20";
    parameter Real k_m_pro = 18.9 "14.961292134394824 18.9, 13";
    parameter Real k_m_ac = 5.1 "3.2111508857602047 5.1, 5.6, 8";
    parameter Real Ks_ac = 0.443583441 "0.21231036725029 0.443583441 , 0.15";
    parameter Real Ki_nh3_ac = 0.00125268 "0.00140997793843472 0.00125268, 0.0071428571";
    parameter Real Ki_hac_ac = 8.06841945 "2.9917458204406238 8.06841945 , 2.2";
    parameter Real Ki_hpro_pro = 2.2 "7.08317113463713 2.2, 2.2";
    parameter Real kla_pilot = 5.821084588 "3.185356158754692 5.821084588, 10";
    parameter Real kla_batch = 10 "12.243650647046891 10,10";
    parameter Real k_m_h2 = 35 "54.19240185230841 35";
    //Added on 17.01.2024
    parameter Real Ks_pro = 0.15 "0.7397859560206168 0.5, 0.15";
    //Added on 22.01.2024
    parameter Real Ks_h2 = 7e-6 "1.119241977682233e-05 6.88E-06, 7e-6";
    parameter Real Ks_c4 = 0.2 "0.14862982759843518 0.244986962, 0.1, 0.2";
    parameter Real Ki_h2_pro = 3.5e-6 "5.650678716932053e-06 4.65E-06, 3.5e-6";
    //
    //From last calibration pilot+batch 23.01.2024
    // parameter Real k_hyd_xchr = 0.1684696193528361;
    //parameter Real k_hyd_xchm = 0.11807316450678314;
    //parameter Real k_hyd_xchs = 0.010760760986597017;
    //parameter Real k_hyd_xprr = 0.8185943523473431;
    //parameter Real k_hyd_xprs = 0.1285879545427303;
    //parameter Real k_hyd_xli = 0.34765782187342564;
    //parameter Real k_m_su = 2.8541211315421355;
    //parameter Real k_m_aa = 27.984700750009836;
    //parameter Real k_m_c4 = 39.3318245823452;
    //parameter Real k_m_pro = 36.93626337790851;
    //parameter Real k_m_ac = 10.177596300593086;
    //parameter Real Ks_ac = 1.2534702928808392;
    //parameter Real Ki_nh3_ac = 0.001020270070831354;
    //parameter Real Ki_hac_ac = 16.221358114327714;
    //parameter Real Ki_hpro_pro = 8.81605943266344;
    //parameter Real kla_pilot = 3.4370650925142736;
    //parameter Real kla_batch = 6.124003382912489;
    //parameter Real Ks_pro = 0.17344311259729606;
    //parameter Real k_m_h2 = 105.50072601219033;
    //parameter Real Ks_h2 = 7.353483393359679e-06;
    //parameter Real Ks_c4 = 0.3280015715682489;
    //parameter Real Ki_h2_pro = 3.6816309143517844e-06;
    //Objective function declaration
    Real ISE(start = 0);
    parameter Real Qch4_maxgain = 10;
