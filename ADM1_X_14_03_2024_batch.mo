    //    Placement(visible = true, transformation(origin = {-124, -90}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //  Modelica.Blocks.Sources.Step step_eggpasta(height = 0.0*feed_ratio*(1 - liquidcontrol_ratio)*4e-4, offset = 0, startTime(displayUnit = "Ms") = 1000000) annotation(
    //    Placement(visible = true, transformation(origin = {-124, -60}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //Impulses
    //  Modelica.Blocks.Sources.Pulse step_slurry(amplitude = -0*(1 - feed_ratio)*(1 - liquidcontrol_ratio)*4e-4, nperiod = 1, period(displayUnit = "s") = 86400, startTime(displayUnit = "Ms") = 1000000, width = 3600/86400*100) annotation(
    //    Placement(visible = true, transformation(origin = {-120, 24}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //  Modelica.Blocks.Sources.Pulse step_semolina(amplitude = 86400/300*feed_ratio*(1 - liquidcontrol_ratio)*4e-4, nperiod = 1, period(displayUnit = "s") = 86400, startTime(displayUnit = "Ms") = 1000000, width = 300/86400*100) annotation(
    //    Placement(visible = true, transformation(origin = {-124, -90}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //  Modelica.Blocks.Sources.Pulse step_eggpasta(amplitude = 0*86400/300*feed_ratio*(1 - liquidcontrol_ratio)*4e-4, nperiod = 1, period(displayUnit = "s") = 86400, startTime(displayUnit = "Ms") = 1000000, width = 300/86400*100) annotation(
    //    Placement(visible = true, transformation(origin = {-124, -60}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //Others
    //  Modelica.Blocks.Sources.SawTooth sawTooth(amplitude=5*2*liquidcontrol_ratio*4e-4, nperiod = -1, period(displayUnit = "s") = 86400, startTime(displayUnit = "Ms") = 1000000)  annotation(
    //    Placement(visible = true, transformation(origin = {-174, 60}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //
    Modelica.Blocks.Math.Add u3 annotation(
      Placement(visible = true, transformation(origin = {-48, -22}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Modelica.Blocks.Math.Add u2 annotation(
      Placement(visible = true, transformation(origin = {-44, 32}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Modelica.Blocks.Math.Add u1 annotation(
      Placement(visible = true, transformation(origin = {-44, 62}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Modelica.Blocks.Math.Add u4 annotation(
      Placement(visible = true, transformation(origin = {-48, -52}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //Outputs
    //y_bar
    Modelica.Blocks.Sources.Constant Qch4_bar(k = 5732) annotation(
