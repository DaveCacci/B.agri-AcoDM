//
    santonio_plus10manure.u[1] = if time < 1e6 then 0 else if time < (1e6 + 17.28e6) then (time - 1e6)*santonio_plus10manure.manure_delta/17.28e6 else santonio_plus10manure.manure_delta;
    santonio_plus10manure.u[2] = if time < 1e6 then 0 else if time < (1e6 + 17.28e6) then (time - 1e6)*santonio_plus10manure.slurry_delta/17.28e6 else santonio_plus10manure.slurry_delta;
