    ADM1_P.Batch_standalone_slurry bmp_slurry(Test_start = 57*86400 + 3600, batch(Ki_hac_ac = Ki_hac_ac, Ki_hpro_pro = Ki_hpro_pro, Ki_nh3_ac = Ki_nh3_ac, Ks_ac = Ks_ac, Ks_pro = Ks_pro, k_hyd_xchm = k_hyd_xchm, k_hyd_xchr = k_hyd_xchr, k_hyd_xchs = k_hyd_xchs, k_hyd_xli = k_hyd_xli, k_hyd_xprr = k_hyd_xprr, k_hyd_xprs = k_hyd_xprs, k_m_aa = k_m_aa, k_m_ac = k_m_ac, k_m_c4 = k_m_c4, k_m_h2 = k_m_h2, k_m_pro = k_m_pro, k_m_su = k_m_su, kla = kla_batch, Ks_h2 = Ks_h2, Ks_c4 = Ks_c4, Ki_h2_pro = Ki_h2_pro, ideality = false)) annotation(
      Placement(visible = true, transformation(origin = {-42, 42}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    ADM1_P.Batch_standalone_maize bmp_maize(Test_start = 57*86400 + 3600, batch(Ki_hac_ac = Ki_hac_ac, Ki_hpro_pro = Ki_hpro_pro, Ki_nh3_ac = Ki_nh3_ac, Ks_ac = Ks_ac, Ks_pro = Ks_pro, k_hyd_xchm = k_hyd_xchm, k_hyd_xchr = k_hyd_xchr, k_hyd_xchs = k_hyd_xchs, k_hyd_xli = k_hyd_xli, k_hyd_xprr = k_hyd_xprr, k_hyd_xprs = k_hyd_xprs, k_m_aa = k_m_aa, k_m_ac = k_m_ac, k_m_c4 = k_m_c4, k_m_h2 = k_m_h2, k_m_pro = k_m_pro, k_m_su = k_m_su, kla = kla_batch, Ks_h2 = Ks_h2, Ks_c4 = Ks_c4, Ki_h2_pro = Ki_h2_pro, ideality = false)) annotation(
      Placement(visible = true, transformation(origin = {-42, 20}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Batch_standalone_tomato bmp_tomato(Test_start = 57*86400 + 3600, batch(Ki_hac_ac = Ki_hac_ac, Ki_hpro_pro = Ki_hpro_pro, Ki_nh3_ac = Ki_nh3_ac, Ks_ac = Ks_ac, Ks_pro = Ks_pro, k_hyd_xchm = k_hyd_xchm, k_hyd_xchr = k_hyd_xchr, k_hyd_xchs = k_hyd_xchs, k_hyd_xli = k_hyd_xli, k_hyd_xprr = k_hyd_xprr, k_hyd_xprs = k_hyd_xprs, k_m_aa = k_m_aa, k_m_ac = k_m_ac, k_m_c4 = k_m_c4, k_m_h2 = k_m_h2, k_m_pro = k_m_pro, k_m_su = k_m_su, kla = kla_batch, Ks_h2 = Ks_h2, Ks_c4 = Ks_c4, Ki_h2_pro = Ki_h2_pro, ideality = false)) annotation(
      Placement(visible = true, transformation(origin = {0, 42}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Batch_standalone_blank bmp_blank(Test_start = 57*86400 + 3600, batch(Ki_hac_ac = Ki_hac_ac, Ki_hpro_pro = Ki_hpro_pro, Ki_nh3_ac = Ki_nh3_ac, Ks_ac = Ks_ac, Ks_pro = Ks_pro, k_hyd_xchm = k_hyd_xchm, k_hyd_xchr = k_hyd_xchr, k_hyd_xchs = k_hyd_xchs, k_hyd_xli = k_hyd_xli, k_hyd_xprr = k_hyd_xprr, k_hyd_xprs = k_hyd_xprs, k_m_aa = k_m_aa, k_m_ac = k_m_ac, k_m_c4 = k_m_c4, k_m_h2 = k_m_h2, k_m_pro = k_m_pro, k_m_su = k_m_su, kla = kla_batch, Ks_h2 = Ks_h2, Ks_c4 = Ks_c4, Ki_h2_pro = Ki_h2_pro, ideality = false)) annotation(
      Placement(visible = true, transformation(origin = {-4, 22}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
  equation
    for i in 1:size(bmp_slurry.comp_inoculum, 1) loop
      bmp_slurry.comp_inoculum[i] = 0;
      bmp_maize.comp_inoculum[i] = 0;
      bmp_blank.comp_inoculum[i] = 0;
      bmp_tomato.comp_inoculum[i] = 0;
    end for;
  protected
    annotation(
      experiment(StartTime = 0, StopTime = 7.776e+06, Tolerance = 1e-5, Interval = 3600),
      __OpenModelica_commandLineOptions = "--matchingAlgorithm=PFPlusExt --indexReductionMethod=dynamicStateSelection -d=initialization,NLSanalyticJacobian --std=latest -d=stateselection -d=bltdump",
      __OpenModelica_simulationFlags(lv = "LOG_STATS", s = "dassl", variableFilter = ".*"),
      Diagram(coordinateSystem(extent = {{-100, -100}, {100, 100}})));
  end BMPs_standalone;

  model ciao
  parameter Real init[3,1] = [1;2;3];
  Real x1(start = init[1,1]);
  Real x2[2](start = init[2:3,1]);
  equation
  der(x1) = 1;
  der(x2) = {0.5,0.6};
  annotation(
      experiment(StartTime = 0, StopTime = 100, Tolerance = 1e-6, Interval = 1),
      __OpenModelica_commandLineOptions = "--matchingAlgorithm=PFPlusExt --indexReductionMethod=dynamicStateSelection -d=initialization,NLSanalyticJacobian --std=latest ",
      __OpenModelica_simulationFlags(lv = "LOG_STATS", s = "dassl", variableFilter = ".*"));
  end ciao;
  
  model AM2HN
  //Modified on 08.04.2024 by Davide Carecci
    //Basato su Appendix A e B di A.Nigro tesi
    //Note: '.*' and './' for element-wise; '*' and '/' for matrix normal operator.
    //Hydrolysis is modelled differently. Particulate inlet are already broke down into degradable and undegradable parts.
    //Operational Parameters -------------------------------------------------------------------------------
    parameter Real V "L";
    parameter Types.Kinetic_d kLa = 0.9 "(d-1)";
    //Parameter input...come costruire matrice da concatenazione vettori?---------------------------------------------------------
    //I shall multiply by TS of each substrate and plug in the fractioning. Be carefull that here X are (gVStot L-1), not the biodegradable fraction! Place these values directly in the equations.
    parameter Real feed1[7] = 1*{1, 1, 0, 0, 0, 1, 0}; 
    parameter Real feed2[7] = 1*{1, 1, 0, 0, 0, 1, 0};
    //  parameter Real xin = [1, 0; 0, 1];
    //  parameter Real xnd = [1, 0];
    //Uncertain parameters model -------------------------------------------------------------------------------
    //Introduce also alfa?
    parameter Types.Kinetic_d Kh[2] = {0.382,0.249} "(d-1) hydrolisis";
    parameter Real Knd[2] = {0.141,0.557} "(gVS gVS-1) stechiometric non degradable";
    parameter Types.Kinetic_d mu_max[2] = {3.5,0.74} "(d-1) maximum growth rates";
    parameter Types.Kinetic_d Kd[2] = {0.235,0.32} "(d-1) biomass decay";
    parameter SI.MassConcentration Ks[2] = {7.1,0.594} "(gCOD L-1) half-saturation constants";
    parameter SI.MassConcentration Ki = 1e5 "(gCOD L-1) inhibition constant for X2 on S2";
    parameter SI.PerUnit K[6] = {28.57,27.15,30.3,1,1,0.0222} "1: yield X1 on S1 (gCOD gVS-1), 2: prod S2 on S1 by X1 (gCOD gVS-1), 3: cons S2 by X2 (gCOD gVS-1), 4: prod CO2 on S1 cons (mmol gVS-1), 5: prod CO2 on S2 cons (mmol gVS-1), 6: yield CH4 prod (mmol gVS-1)";
    parameter SI.PerUnit K0[2] = {24.91,13.81} "(gCOD gVS-1) stechiometric from X to S1";
    //Initial conditions -------------------------------------------------------------------------------
    parameter SI.MassConcentration X_start[2] = {5,5} "(gVS L-1)";
    parameter SI.MassConcentration Xnd_start = {5,5} "(gVS L-1)";
    parameter SI.MassConcentration Xb_start[2] = {1,1} "(gVS L-1)";
    parameter SI.MassConcentration S_start[2] = {2,0.5} "(gCOD L-1)";
    //State Variables -------------------------------------------------------------------------------
    SI.MassConcentration X[2](each fixed = true, start = X_start) "Degradable particulate matters (gVS L-1)";
    SI.MassConcentration Xnd(fixed = true, start = Xnd_start) "Undegradable particulate matters (gVS L-1)";
    SI.MassConcentration Xb[2](each fixed = true, start = Xb_start) "Alive bacterial biomass, 1:acidogens, 2: methanogens (gVS L-1)";
    SI.MassConcentration S[2](each fixed = true, start = S_start) "Soluble organic matter, 1: organic solubles, 2:VFA (gCOD L-1)";
    //Algebraic Variables -------------------------------------------------------------------------------
    Real Q;
    Real x[7];
    //Outputs -------------------------------------------------------------------------------
    SI.MassConcentration VFA;
    Real Qch4;
    SI.MassConcentration VS;
    //Interfaces -------------------------------------------------------------------------------
    Modelica.Blocks.Interfaces.RealInput q[2](each start = 0.5) annotation(
      Placement(visible = true, transformation(origin = {-100, -12}, extent = {{-20, -20}, {20, 20}}, rotation = 0), iconTransformation(origin = {-80, 10}, extent = {{-20, -20}, {20, 20}}, rotation = 0)));
    Modelica.Blocks.Interfaces.RealOutput y[3] annotation(
      Placement(visible = true, transformation(origin = {98, 0}, extent = {{-20, -20}, {20, 20}}, rotation = 0), iconTransformation(origin = {90, -8}, extent = {{-20, -20}, {20, 20}}, rotation = 0)));
  equation
  //Algebraic -------------------------------------------------------------------------------
    Q = sum(q[i] for i in 1:size(q, 1));
  //States -------------------------------------------------------------------------------
    24*3600*der(X) = Q/V*(X_in - X) - Kh.*X;
    24*3600*der(Xnd) = Q/V*(Xnd_in - Xnd) + Kh[1]*Knd[1]*X[1] + Kh[2]*Knd[2]*X[2];
    24*3600*der(Xb) = Q/V*(Xb_in - Xb) + {mu_max[1]*S[1]/(S[1] + Ks[1]), mu_max[2]*S[2]/(S[2] + Ks[2] + S[2]^2/Ki)}.*Xb - Kd.*Xb;
    24*3600*der(S) = Q/V*(S_in - S) + [K0[1]*Kh[1], K0[2]*Kh[2]; 0, 0]*X + [-K[1]*mu_max[1]*S[1]/(S[1] + Ks[1]), 0; +K[2]*mu_max[2]*S[1]/(S[1] + Ks[1]), -K[3]*mu_max[2]*S[2]/(S[2] + Ks[2] + S[2]^2/Ki)]*Xb;
   //Introduce alkalinity
   //Introduce inorganic carbon
    x = cat(1, X, {Xnd}, Xb, S);
  //Outputs -------------------------------------------------------------------------------
    VFA = S[2];
    Qch4 = kLa*K[4]*mu_max[2]*S[2]/(S[2] + Ks[2] + S[2]^2/Ki)*Xb[2];
    VS = X[1] + X[2] + Xnd + Xb[1] + Xb[2];
    y = {VFA, Qch4, VS};
    annotation(
      experiment(StartTime = 0, StopTime = 1, Tolerance = 1e-06, Interval = 0.002),
      __OpenModelica_commandLineOptions = "--matchingAlgorithm=PFPlusExt --indexReductionMethod=dynamicStateSelection -d=initialization,NLSanalyticJacobian --std=latest ",
      __OpenModelica_simulationFlags(lv = "LOG_STATS", s = "dassl", variableFilter = ".*"));
  end AM2HN;
  
model AM2HN_Allegrini
//AMOCO parameters
 parameter Real AM_mu_1_max = 0.17; //specific growth rate of acidogenesis (d-1)
 parameter Real AM_mu_2_max = 0.73; //specific growth rate of methanization (d-1)
 parameter Real AM_k_H = 16; //Henry constant (mmol/L/atm) (*)
 parameter Real AM_k_l_a = 24.07; //liquid-gas transfer constant (d-1)
 parameter Real AM_K_I_2 = 19.3; //inhibition constant associated to S2 (mmol/L)
 parameter Real AM_K_a = 1.5e-5; //affinity constant of acetic acid and acetate (mol/L) (*)
 parameter Real AM_K_b = 6.5e-7; //affinity constant of Bicarbonates and CO2 (mol/L) (*)
parameter Real AM_K_S1 = 1.18; //g/L
 parameter Real AM_K_S2 = 4.66; //mmol/L
 parameter Real AM_k_1 = 13.02; //yield for substrate(COD) degradation (-)
 parameter Real AM_k_2 = 101.08; //yield for VFA production (mmol/g)
 parameter Real AM_k_3 = 187.85; //yield for VFA consumption (mmol/g)
 parameter Real AM_k_4 = 53.25; //yield for CO2 production from X1(mmol/g)
 parameter Real AM_k_5 = 177.09; //yield for CO2 production from X2(mmol/g)
 parameter Real AM_k_6 = 383.2; //yield for CH4 production (mmol/g)

 parameter Real AM_N_bac = 0.08/14*1000*1.55; //nitrogen content of biomass (mmolN/gVS)
 parameter Real AM_N_aa = 0.007*1000*1.55; //nitrogen content of amino acids and proteins (mmolN/gVS)
 parameter Real AM_f_aa = 0.00003; //fraction of amino acids in the organic substrate, S1
//----------------------------------------------------------------------------------------------------
 parameter Real AM_f_pr = 0.62; //fraction of proteins in the organic substrate, S1
 parameter Real AM_f_xc = 0.06; //fraction of composite in the organic substrate, S1
 parameter Real AM_f_xc_pr = 0.2; //fraction of proteins in the composite, X_c

//AMOCO parameters
 parameter Real set2_AM_mu_1_max = 0.206; //specific growth rate of acidogenesis (d-1)
 parameter Real set2_AM_mu_2_max = 0.20; //specific growth rate of methanization (d-1)
 parameter Real set2_AM_k_H = 16; //Henry constant (mmol/L/atm) (*)
 parameter Real set2_AM_k_l_a = 24.2; //liquid-gas transfer constant (d-1)
 parameter Real set2_AM_K_I_2 = 433968; //inhibition constant associated to S2 (mmol/L)
 parameter Real set2_AM_K_a = 1.5e-5; //affinity constant of acetic acid and acetate (mol/L) (*)
 parameter Real set2_AM_K_b = 6.5e-7; //affinity constant of Bicarbonates and CO2 (mol/L) (*)
 parameter Real set2_AM_K_S1 = 1.096; //g/L
 parameter Real set2_AM_K_S2 = 6.86; //mmol/L
 parameter Real set2_AM_k_1 = 15.0; //yield for substrate(COD) degradation (-)
 parameter Real set2_AM_k_2 = 198.7; //yield for VFA production (mmol/g)
 parameter Real set2_AM_k_3 = 440.1; //yield for VFA consumption (mmol/g)
 parameter Real set2_AM_k_4 = 747.0; //yield for CO2 production from X1(mmol/g)
 parameter Real set2_AM_k_5 = 84.2; //yield for CO2 production from X2(mmol/g)
 parameter Real set2_AM_k_6 = 422.8; //yield for CH4 production (mmol/g)
 //----------------------------------------------------------------------------------------------------
 //AMOCO state variables
 Real AM_X1(start=1.79203); //gVS/L
 Real AM_X2(start=0.52289); //gVS/L
 Real AM_S1(start=0.76664); //gCOD/L
 Real AM_S2(start=0.95284); //mmol/L
 Real AM_C(start=236.8246); //mmol/L
 Real AM_N(start=203.48); //inorganic nitrogen (mmol/L)
 Real AM_B; //bicarbonates (mmol/L)
 Real AM_Z(start=233.60108); //mmol/L

 Real AM_CO2; //dissolved CO2 (mmol/L)
 Real AM_q_c; //molar CO2 flow rate (mmol/L/d)
 Real AM_P_c; //partial pressure of CO2 (atm)
 Real AM_P_t; //total pressure in the fermenter (=1atm)
 Real AM_phi;
 Real AM_mu_1; //growth rate of X1 (d-1)
 Real AM_mu_2; // growth rate of X2 (d-1)
 Real AM_pH;
 Real AM_D; //dilution rate of the fermenter (d-1)
 Real AM_q_ch4; //outflow rate of methane (mmol/L/d)

 //AMOCO state variables Set2
 Real set2_AM_X1(start=1.48530); //gVS/L
 Real set2_AM_X2(start=0.670017); //gVS/L
 Real set2_AM_S1(start=0.57091); //gCOD/L
 Real set2_AM_S2(start=3.69386); //mmol/L
 Real set2_AM_C(start=248.12192); //mmol/L
 Real set2_AM_N(start=206.36773); //inorganic nitrogen (mmol/L)
 Real set2_AM_B; //bicarbonates (mmol/L)
 Real set2_AM_Z(start=236.28645); //mmol/L

 Real set2_AM_CO2; //dissolved CO2 (mmol/L)
 Real set2_AM_q_c; //molar CO2 flow rate (mmol/L/d)
 Real set2_AM_P_c; //partial pressure of CO2 (atm)
 Real set2_AM_phi;
 Real set2_AM_mu_1; //growth rate of X1 (d-1)
 Real set2_AM_mu_2; // growth rate of X2 (d-1)
 Real set2_AM_pH;
 Real set2_AM_q_ch4; //outflow rate of methane (mmol/L/d)

 Real AM_alfa; //fraction of biomass in the liquid phase, HRT/SRT
 Real AM_S1_in; //gCOD/L
 Real AM_S2_in; //mmol/L
 Real AM_Z_in; //mmol/L
 Real AM_C_in; //mmol/L
 Real AM_B_in; //mmol/L
 Real AM_N_in; //mmol/L
 Real AM_pH_in;
//---------------------------------------------------------------------------
 Real S_su_in;
 Real S_aa_in;
 Real S_fa_in;
 Real S_va_in;
 Real S_bu_in;
 Real S_pro_in;
 Real S_ac_in;
 Real S_h2_in;
 Real S_ch4_in;
 Real S_ic_in;
 Real S_in_in;
 Real S_i_in;
 Real S_cat_in;
 Real S_an_in;
 Real X_su_in;
 Real X_aa_in;
 Real X_fa_in;
 Real X_c4_in;
 Real X_pro_in;
 Real X_ac_in;
 Real X_h2_in;
 Real X_i_in;
 Real X_c_in;
 Real X_ch_in;
 Real X_pr_in;
 Real X_li_in;
 //---------------------------------------------------------------------------
// Operational parameters

 Real resa_gas;
 Real OLR; // (kgCOD/m3/d)
 Real HRT; // (d)
 Real BPR; // (Nm3/m3/d)
 Real MPR; //(Nm3/m3/d)
 Real SRT; // (d)
 Real f_X; // fattore di separazione delle specie particolate =HRT/SRT o =Xout/Xreattore
 Real X_tot_r; // concentrazione totale di particolato nel reattore
// Aggregated variables

 Real COD_IN;
 Real COD_VFA_IN;
 Real COD_s_IN;
 Real COD_p_IN;
 Real COD_OUT;
 Real COD_VFA_OUT;
 Real COD_s_OUT;
 Real COD_p_OUT;
 Real COD_gas;
 Real COD_bio_IN;
 Real COD_bio_OUT;
 
equation

// Aggregated variables
 COD_IN = COD_s_IN+COD_p_IN;
 COD_VFA_IN = S_va_in+S_bu_in+S_pro_in+S_ac_in;
 COD_s_IN = S_su_in+S_aa_in+S_fa_in+COD_VFA_IN+S_ch4_in+S_h2_in+S_i_in;
 COD_p_IN = X_c_in+X_ch_in+X_pr_in+X_li_in+COD_bio_IN+X_i_in;
 COD_bio_IN = X_su_in+X_aa_in+X_fa_in+X_c4_in+X_pro_in+X_ac_in+X_h2_in;

 COD_OUT = COD_s_OUT+COD_p_OUT;
 COD_VFA_OUT = S_va+S_bu+S_pro+S_ac;
 COD_s_OUT = S_su+S_aa+S_fa+COD_VFA_OUT+S_ch4+S_h2+S_i;
 COD_p_OUT = f_X*(X_c+X_ch+X_pr+X_li)+COD_bio_OUT+X_i;
 COD_bio_OUT = f_X*(X_su+X_aa+X_fa+X_c4+X_pro+X_ac+X_h2);
 COD_gas = (S_gas_ch4+S_gas_h2)*q_gas/qin;
 check = COD_IN-COD_OUT-COD_gas;
//----------------------------------------------------------------------
// Operational parameters
 OLR = COD_IN/HRT; // (kgCOD/m3/d)
 HRT = Vl/qin; // (d)
 resa_gas = COD_gas/COD_IN; // (kgCOD_CH4/kgCOD_IN)
 BPR = q_gas*273/(273+Top)/Vl; // (Nm3/m3/d)
 MPR = BPR*p_gas_ch4; //(Nm3/m3/d)
 SRT = HRT/f_X; // (d)
 X_tot_r = COD_p_OUT/f_X; //(kgCOD/m3)
 //------------------------------------------------------------------------
 //Input values and perturbations
 S_su_in = 0.01;
 S_aa_in = 0.001;
 S_fa_in = 0.001;
 S_va_in = 0.001;
 S_bu_in = 0.001;
 S_pro_in = 0.001;
 S_ac_in = 0.001;
 S_h2_in = 1e-8;
 S_ch4_in = 1e-5;
 S_ic_in = 0.04;
 S_in_in = 0.01;
 S_i_in = 0.02;
 S_cat_in = 0.04;
 S_an_in = 0.02;
 X_su_in = 0;
 X_aa_in = 0.01;
 X_fa_in = 0.01;
 X_c4_in = 0.01;
 X_pro_in = 0.01;
 X_ac_in = 0.01;
 X_h2_in = 0.01;
 X_i_in = 25.0;
 X_c_in = 2;
 X_ch_in = 5;
 X_pr_in = 20;
 X_li_in = 5;
 //--------------------------------------------------------------------------------
//AMOCO equations
AM_S1_in = S_su_in+S_aa_in+S_fa_in+X_c_in+X_ch_in+X_pr_in+X_li_in; //gCOD/L
 AM_S2_in = (S_va_in/208+S_bu_in/160+S_pro_in/112+S_ac_in/64)*1000; //mmol/L
 AM_C_in = S_ic_in*1000; //mmol/L
 AM_B_in = 0.000000494*S_ic_in*1000/(0.000000494+10^(-AM_pH_in)); //mmol/L
 AM_Z_in = AM_B_in+0.000015/(0.000015+10^(-AM_pH_in))*AM_S2_in + AM_N_in;
//mmol/L (Attento!! il pH non è quello del digestore)
 AM_N_in = S_in_in*1000; //mmol/L

 AM_alfa = HRT/SRT;
 AM_P_t = 1; //atm, according to k_H UM
 AM_pH_in = 6.78; //pH of the influent

 AM_CO2 = AM_C + AM_S2 - AM_Z;
 AM_B = AM_Z - AM_S2; //B_in is already considered inside Z
 AM_D = 1/HRT;

 AM_q_c = AM_k_l_a*(AM_CO2-AM_k_H*AM_P_c); //mmol/L/d
 AM_P_c = (AM_phi-sqrt(AM_phi^2-4*AM_k_H*AM_P_t*AM_CO2))/(2*AM_k_H);
 AM_phi = AM_CO2+AM_k_H*AM_P_t+AM_k_6/AM_k_l_a*AM_mu_2*AM_X2;

 AM_mu_1 = AM_mu_1_max*AM_S1/(AM_S1+AM_K_S1);
 AM_mu_2 = AM_mu_2_max*AM_S2/(AM_S2+AM_K_S2+AM_S2^2/AM_K_I_2);

 AM_pH = -Modelica.Math.log10(AM_K_b*AM_CO2/AM_B);

24*3600*der(AM_X1) = (AM_mu_1-AM_alfa*AM_D-0.1*AM_mu_1_max)*AM_X1;
24*3600*der(AM_X2) = (AM_mu_2-AM_alfa*AM_D-0.1*AM_mu_2_max)*AM_X2;
24*3600*der(AM_Z) = AM_D*(AM_Z_inAM_Z)+(AM_k_1*(AM_f_aa+AM_f_pr+AM_f_xc*AM_f_xc_pr)*AM_N_aa -
AM_N_bac)*AM_mu_1*AM_X1-AM_N_bac*AM_mu_2*AM_X2 + AM_N_bac*0.1*AM_mu_1_max*AM_X1 +
AM_N_bac*0.1*AM_mu_2_max*AM_X2;
24*3600*der(AM_S1) = AM_D*(AM_S1_in-AM_S1)-AM_k_1*AM_mu_1*AM_X1;
24*3600*der(AM_S2) = AM_D*(AM_S2_in-AM_S2)+AM_k_2*AM_mu_1*AM_X1-
AM_k_3*AM_mu_2*AM_X2;
24*3600*der(AM_C) = AM_D*(AM_C_in-AM_C)-
AM_q_c+AM_k_4*AM_mu_1*AM_X1+AM_k_5*AM_mu_2*AM_X2;
24*3600*der(AM_N) = AM_D*(AM_N_inAM_N)+(AM_k_1*(AM_f_aa+AM_f_pr+AM_f_xc*AM_f_xc_pr)*AM_N_aa -
AM_N_bac)*AM_mu_1*AM_X1-AM_N_bac*AM_mu_2*AM_X2 + AM_N_bac*0.1*AM_mu_1_max*AM_X1 +
AM_N_bac*0.1*AM_mu_2_max*AM_X2;

 AM_q_ch4 = AM_k_6*AM_mu_2*AM_X2;

 AM_dyn_X1 = AM_X1/1.79203;
 AM_dyn_X2 = AM_X2/0.52289;
 AM_dyn_S1 = AM_S1/0.76664;
 AM_dyn_S2 = AM_S2/0.95284;
 AM_dyn_Z = AM_Z/233.60108;
 AM_dyn_C = AM_C/236.8246;
 AM_dyn_B = AM_B/232.60108;
 AM_dyn_N = AM_N/203.48;

 AM_dyn_CO2 = AM_CO2/4.22361;
 AM_dyn_q_c = AM_q_c/7.9281;
 AM_dyn_pH = AM_pH/7.92801;
 AM_dyn_q_ch4 = AM_q_ch4/24.64559;

 // AMOCO Set2
 set2_AM_CO2 = set2_AM_C + set2_AM_S2 - set2_AM_Z;
 set2_AM_B = set2_AM_Z - set2_AM_S2; //B_in is already considered inside Z

 set2_AM_q_c = set2_AM_k_l_a*(set2_AM_CO2-AM_k_H*set2_AM_P_c); //mmol/L/d
 set2_AM_P_c = (set2_AM_phi-sqrt(set2_AM_phi^2- 4*AM_k_H*AM_P_t*set2_AM_CO2))/(2*AM_k_H);
 set2_AM_phi = set2_AM_CO2+AM_k_H*AM_P_t+set2_AM_k_6/set2_AM_k_l_a*set2_AM_mu_2*set2_AM_X2;

 set2_AM_mu_1 = set2_AM_mu_1_max*set2_AM_S1/(set2_AM_S1+set2_AM_K_S1);
 set2_AM_mu_2 = set2_AM_mu_2_max*set2_AM_S2/(set2_AM_S2+set2_AM_K_S2+set2_AM_S2^2/set2_AM_K_I_2);

 set2_AM_pH = -Modelica.Math.log10(AM_K_b*set2_AM_CO2/set2_AM_B);

24*3600*der(set2_AM_X1) = (set2_AM_mu_1-AM_alfa*AM_D-0.1*set2_AM_mu_1_max)*set2_AM_X1;
24*3600*der(set2_AM_X2) = (set2_AM_mu_2-AM_alfa*AM_D-0.1*set2_AM_mu_2_max)*set2_AM_X2;
24*3600*der(set2_AM_Z) = AM_D*(AM_Z_inset2_AM_Z)+(set2_AM_k_1*(AM_f_aa+AM_f_pr+AM_f_xc*AM_f_xc_pr)*AM_N_aa-AM_N_bac)*set2_AM_mu_1*set2_AM_X1AM_N_bac*set2_AM_mu_2*set2_AM_X2 + AM_N_bac*0.1*set2_AM_mu_1_max*set2_AM_X1 + AM_N_bac*0.1*set2_AM_mu_2_max*set2_AM_X2;
24*3600*der(set2_AM_S1) = AM_D*(AM_S1_in-set2_AM_S1)- set2_AM_k_1*set2_AM_mu_1*set2_AM_X1;
24*3600*der(set2_AM_S2) = AM_D*(AM_S2_inset2_AM_S2)+set2_AM_k_2*set2_AM_mu_1*set2_AM_X1-set2_AM_k_3*set2_AM_mu_2*set2_AM_X2;
24*3600*der(set2_AM_C) = AM_D*(AM_C_in-set2_AM_C)- set2_AM_q_c+set2_AM_k_4*set2_AM_mu_1*set2_AM_X1+set2_AM_k_5*set2_AM_mu_2*set2_AM_X2;
24*3600*der(set2_AM_N) = AM_D*(AM_N_inset2_AM_N)+(set2_AM_k_1*(AM_f_aa+AM_f_pr+AM_f_xc*AM_f_xc_pr)*AM_N_aa -AM_N_bac)*set2_AM_mu_1*set2_AM_X1-AM_N_bac*set2_AM_mu_2*set2_AM_X2 + AM_N_bac*0.1*set2_AM_mu_1_max*set2_AM_X1 + AM_N_bac*0.1*set2_AM_mu_2_max*set2_AM_X2;

 set2_AM_q_ch4 = set2_AM_k_6*set2_AM_mu_2*set2_AM_X2;

 set2_AM_dyn_X1 = set2_AM_X1/1.4853;
 set2_AM_dyn_X2 = set2_AM_X2/0.670017;
 set2_AM_dyn_S1 = set2_AM_S1/0.57091;
 set2_AM_dyn_S2 = set2_AM_S2/3.69386;
 set2_AM_dyn_Z = set2_AM_Z/236.28645;
 set2_AM_dyn_C = set2_AM_C/248.12192;
 set2_AM_dyn_B = set2_AM_B/232.61617;
 set2_AM_dyn_N = set2_AM_N/206.36773;

 set2_AM_dyn_CO2 = set2_AM_CO2/15.50575;
 set2_AM_dyn_q_c = set2_AM_q_c/71.81489;
 set2_AM_dyn_pH = set2_AM_pH/7.36323;
 set2_AM_dyn_q_ch4 = set2_AM_q_ch4/19.82814;
  annotation(
    experiment(StartTime = 0, StopTime = 1, Tolerance = 1e-06, Interval = 0.002),
    __OpenModelica_commandLineOptions = "--matchingAlgorithm=PFPlusExt --indexReductionMethod=dynamicStateSelection -d=initialization,NLSanalyticJacobian --std=latest ",
    __OpenModelica_simulationFlags(lv = "LOG_STATS", s = "dassl", variableFilter = ".*"));
end AM2HN_Allegrini;
  
  model AM2HN_mine
  //Modified on 08.04.2024 by Davide Carecci
    //Basato su Appendix A e B di A.Nigro tesi
    //Note: '.*' and './' for element-wise; '*' and '/' for matrix normal operator.
    //Hydrolysis is modelled differently. Particulate inlet are already broke down into degradable and undegradable parts.
    //Operational Parameters -------------------------------------------------------------------------------
    parameter SI.Volume V = 12 "L";
    parameter Types.Kinetic_d kLa = 0.9 "(d-1)";
    //Parameter input...come costruire matrice da concatenazione vettori?---------------------------------------------------------
    //I shall multiply by TS of each substrate and plug in the fractioning. Be carefull that here X are (gVStot L-1), not the biodegradable fraction!
    parameter Real feed1[7] = 1*{0, 1, 1, 0, 0, 1, 1}; 
    parameter Real feed2[7] = 1*{0, 1, 1, 0, 0, 1, 1};
    parameter Real feed3[2,7] = [0.4, 0.3, 0.15, 0, 0, 0, 0.1;
                                 0.1, 0.15, 0.4, 0, 0, 0, 0.05];
   parameter Real TSfeed[2] = {250,60} "gTS L-1";
    //  parameter Real xin = [1, 0; 0, 1];
    //  parameter Real xnd = [1, 0];
    //Uncertain parameters model -------------------------------------------------------------------------------
    //Introduce also alfa?
    parameter Types.Kinetic_d Kh[2] = {0.382,0.249} "(d-1) hydrolisis";
    parameter Real Knd[2] = {0.141,0.557} "(gVS gVS-1) stechiometric non degradable";
    parameter Types.Kinetic_d mu_max[2] = {3.5,0.74} "(d-1) maximum growth rates";
    parameter Types.Kinetic_d Kd[2] = {0.235,0.32} "(d-1) biomass decay";
    parameter SI.MassConcentration Ks[2] = {7.1,0.594} "(gCOD L-1) half-saturation constants";
    parameter SI.MassConcentration Ki = 1e5 "(gCOD L-1) inhibition constant for X2 on S2";
    parameter SI.PerUnit K[6] = {28.57,27.15,30.3,1,1,0.0222} "1: yield X1 on S1 (gCOD gVS-1), 2: prod S2 on S1 by X1 (gCOD gVS-1), 3: cons S2 by X2 (gCOD gVS-1), 4: prod CO2 on S1 cons (mmol gVS-1), 5: prod CO2 on S2 cons (mmol gVS-1), 6: yield CH4 prod (mmol gVS-1)";
    parameter SI.PerUnit K0[2] = {24.91,13.81} "(gCOD gVS-1) stechiometric from X to S1";
    //Initial conditions -------------------------------------------------------------------------------
    parameter SI.MassConcentration X_start[2] = {5,5} "(gVS L-1)";
    parameter SI.MassConcentration Xnd_start = 5 "(gVS L-1)";
    parameter SI.MassConcentration Xb_start[2] = {1,1} "(gVS L-1)";
    parameter SI.MassConcentration S_start[2] = {2,0.5} "(gCOD L-1)";
    //State Variables -------------------------------------------------------------------------------
    SI.MassConcentration X[2](each fixed = true, start = X_start) "Degradable particulate matters (gVS L-1)";
    SI.MassConcentration Xnd(fixed = true, start = Xnd_start) "Undegradable particulate matters (gVS L-1)";
    SI.MassConcentration Xb[2](each fixed = true, start = Xb_start) "Alive bacterial biomass, 1:acidogens, 2: methanogens (gVS L-1)";
    SI.MassConcentration S[2](each fixed = true, start = S_start) "Soluble organic matter, 1: organic solubles, 2:VFA (gCOD L-1)";
    //Algebraic Variables -------------------------------------------------------------------------------
    Real Q;
    // Real COD_VS_influent =
    SI.MassConcentration X_in[2];
    SI.MassConcentration Xnd_in;
    SI.MassConcentration Xb_in[2];
    SI.MassConcentration S_in[2];
    Real HRT, OLR, VS_in;
    Real x[7];
    //Outputs -------------------------------------------------------------------------------
    SI.MassConcentration VFA;
    Real Qch4;
    SI.MassConcentration VS;
    //Interfaces -------------------------------------------------------------------------------
    Modelica.Blocks.Interfaces.RealInput q[2](each start = 0.5) annotation(
      Placement(visible = true, transformation(origin = {-100, -12}, extent = {{-20, -20}, {20, 20}}, rotation = 0), iconTransformation(origin = {-80, 10}, extent = {{-20, -20}, {20, 20}}, rotation = 0)));
    Modelica.Blocks.Interfaces.RealOutput y[3] annotation(
      Placement(visible = true, transformation(origin = {98, 0}, extent = {{-20, -20}, {20, 20}}, rotation = 0), iconTransformation(origin = {90, -8}, extent = {{-20, -20}, {20, 20}}, rotation = 0)));
  equation
  //Algebraic -------------------------------------------------------------------------------
    Q = sum(q[i] for i in 1:size(q, 1));
    X_in = {sum(q[i]*TSfeed[i]*feed3[i,1] for i in 1:size(q, 1)),sum(q[i]*TSfeed[i]*feed3[i,2] for i in 1:size(q, 1))}/Q;
    Xnd_in = sum(q[i]*TSfeed[i]*feed3[i,3] for i in 1:size(q, 1))/Q;
    Xb_in = {sum(q[i]*TSfeed[i]*feed3[i,4] for i in 1:size(q, 1)),sum(q[i]*TSfeed[i]*feed3[i,5] for i in 1:size(q, 1))}/Q;
    S_in = {sum(q[i]*TSfeed[i]*feed3[i,6] for i in 1:size(q, 1)),sum(q[i]*TSfeed[i]*feed3[i,7] for i in 1:size(q, 1))}/Q;
  //  X_in = [feed1[1], feed2[1]; feed1[2], feed2[2]]*q/Q;
  //  Xnd_in = {feed1[3], feed2[3]}*q/Q;
  //  Xb_in = [feed1[4], feed2[4]; feed1[5], feed2[5]]*q/Q;
  //  S_in = [feed1[4], feed2[4]; feed1[5], feed2[5]]*q/Q;
  //States -------------------------------------------------------------------------------
    24*3600*der(X) = Q/V*(X_in - X) - Kh.*X;
    24*3600*der(Xnd) = Q/V*(Xnd_in - Xnd);
    24*3600*der(Xb) = Q/V*(Xb_in - Xb) + {mu_max[1]*S[1]/(S[1] + Ks[1]), mu_max[2]*S[2]/(S[2] + Ks[2] + S[2]^2/Ki)}.*Xb - Kd.*Xb;
    24*3600*der(S) = Q/V*(S_in - S) + [Kh[1],Kh[2]; 0, 0]*X + [-K[1]*mu_max[1]*S[1]/(S[1] + Ks[1]), 0; +K[2]*mu_max[2]*S[1]/(S[1] + Ks[1]), -K[3]*mu_max[2]*S[2]/(S[2] + Ks[2] + S[2]^2/Ki)]*Xb;
   //Introduce alkalinity
   //Introduce inorganic carbon
    x = cat(1, X, {Xnd}, Xb, S);
  //Outputs -------------------------------------------------------------------------------
    VFA = S[2];
    Qch4 = 1000*22.4*kLa*K[6]*mu_max[2]*S[2]/(S[2] + Ks[2] + S[2]^2/Ki)*Xb[2]/24 "L d-1";
    VS = X[1] + X[2] + Xnd + Xb[1] + Xb[2]; //conversion COD/VS S1 and S2? Better to check with COD
    y = {VFA, Qch4, VS};
    HRT = V/Q;
    VS_in = sum(X_in[i] for i in 1:size(X_in, 1))+Xnd_in+sum(Xb_in[i] for i in 1:size(Xb_in, 1))+sum(S_in[i] for i in 1:size(S_in, 1)) "gVS L-1";
    OLR = VS_in*Q/V; //conversion COD/VS S1 and S2? Better to check with COD
    annotation(
      experiment(StartTime = 0, StopTime = 1, Tolerance = 1e-06, Interval = 0.002),
      __OpenModelica_commandLineOptions = "--matchingAlgorithm=PFPlusExt --indexReductionMethod=dynamicStateSelection -d=initialization,NLSanalyticJacobian --std=latest ",
      __OpenModelica_simulationFlags(lv = "LOG_STATS", s = "dassl", variableFilter = ".*"));
  end AM2HN_mine;

  model UIT_AMH2N
  AM2HN_mine aM2HN_mine annotation(
      Placement(visible = true, transformation(origin = {-4, 0}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
  equation
aM2HN_mine.q = {0.031,0.243};
  annotation(
      experiment(StartTime = 0, StopTime = 8640000, Tolerance = 1e-6, Interval = 3600),
      __OpenModelica_commandLineOptions = "--matchingAlgorithm=PFPlusExt --indexReductionMethod=dynamicStateSelection -d=initialization,NLSanalyticJacobian --std=latest ",
      __OpenModelica_simulationFlags(lv = "LOG_STATS", s = "dassl", variableFilter = ".*"));
end UIT_AMH2N;
  annotation(
    uses(Modelica(version = "4.0.0"), Modelica_LinearSystems2(version = "2.4.0")));
  annotation(
    uses(Modelica(version = "4.0.0"), Modelica_LinearSystems2(version = "2.4.0")));
end ADM1_P;
