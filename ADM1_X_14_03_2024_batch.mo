  model UIT_CL_selector_ratio_mine_discrete
    UIT_OL uit_ol(impulse = false, uit(q(start = {0.24*4e-4, (1 - 0.24)*(1 - 0.4)*4e-4, (1 - 0.24)*0.4*4e-4, 0, 0}))) annotation(
