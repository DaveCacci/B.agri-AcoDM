  model SAntonio_optim
    SAntonio_OL santonio_plus10maize(maize_delta = maize_delta, manure_delta = manure_delta, slurry_delta = slurry_delta, tomatopeels_delta = tomatopeels_delta, u(each fixed = true, start = {0, 0, 0, 0})) annotation(
