    UIT_OL_Jan24_onoff_gasbag pilot_Ks_su(uit.digester.Ks_su = Ks_su*(1 + deltap), uit.digester.k_hyd_xchr = k_hyd_xchr, uit.digester.k_hyd_xchm = k_hyd_xchm, uit.digester.k_hyd_xchs = k_hyd_xchs, uit.digester.k_hyd_xprr = k_hyd_xprr, uit.digester.k_hyd_xprs = k_hyd_xprs, uit.digester.k_hyd_xli = k_hyd_xli, uit.digester.k_m_su = k_m_su, uit.digester.k_m_aa = k_m_aa, uit.digester.k_m_c4 = k_m_c4, uit.digester.k_m_pro = k_m_pro, uit.digester.k_m_ac = k_m_ac, uit.digester.Ks_ac = Ks_ac, uit.digester.Ki_nh3_ac = Ki_nh3_ac, uit.digester.Ki_hac_ac = Ki_hac_ac, uit.digester.kla = kla, uit.digester.k_m_h2 = k_m_h2, uit.digester.Ki_h2_c4 = Ki_h2_c4, uit.digester.Ki_h2_pro = Ki_h2_pro, uit.digester.Ks_c4 = Ks_c4, uit.digester.Ks_h2 = Ks_h2, uit.digester.Ks_pro = Ks_pro, impulse = impulse);
    //Declare sesnsitivity index varaiables
    //  Real SI_Vcumch4_k_hyd_xchr, SI_Vcumch4_k_hyd_xchm, SI_Vcumch4_k_hyd_xchs, SI_Vcumch4_k_hyd_xprr, SI_Vcumch4_k_hyd_xprs, SI_Vcumch4_k_hyd_xli, SI_Vcumch4_k_m_su, SI_Vcumch4_k_m_aa, SI_Vcumch4_k_m_c4, SI_Vcumch4_k_m_pro, SI_Vcumch4_k_m_ac, SI_Vcumch4_k_s_ac, SI_Vcumch4_Ki_nh3_ac, SI_Vcumch4_kla;
    Real SI_Qch4_k_hyd_xchr, SI_Qch4_k_hyd_xchm, SI_Qch4_k_hyd_xchs, SI_Qch4_k_hyd_xprr, SI_Qch4_k_hyd_xprs, SI_Qch4_k_hyd_xli, SI_Qch4_k_m_su, SI_Qch4_k_m_aa, SI_Qch4_k_m_c4, SI_Qch4_k_m_pro, SI_Qch4_k_m_ac, SI_Qch4_k_s_ac, SI_Qch4_Ki_nh3_ac, SI_Qch4_kla, SI_Qch4_Ki_hac_ac, SI_Qch4_Ki_hpro_pro, SI_Qch4_k_m_h2, SI_Qch4_Ki_h2_c4, SI_Qch4_Ki_h2_pro, SI_Qch4_Ks_c4, SI_Qch4_Ks_h2, SI_Qch4_Ks_pro, SI_Qch4_Ks_su;
    Real SI_VFA_k_hyd_xchr, SI_VFA_k_hyd_xchm, SI_VFA_k_hyd_xchs, SI_VFA_k_hyd_xprr, SI_VFA_k_hyd_xprs, SI_VFA_k_hyd_xli, SI_VFA_k_m_su, SI_VFA_k_m_aa, SI_VFA_k_m_c4, SI_VFA_k_m_pro, SI_VFA_k_m_ac, SI_VFA_k_s_ac, SI_VFA_Ki_nh3_ac, SI_VFA_kla, SI_VFA_Ki_hac_ac, SI_VFA_Ki_hpro, SI_VFA_k_m_h2, SI_VFA_Ki_h2_c4, SI_VFA_Ki_h2_pro, SI_VFA_Ks_c4, SI_VFA_Ks_h2, SI_VFA_Ks_pro, SI_VFA_Ks_su;
    Real SI_Ch4_CO2_k_hyd_xchr, SI_Ch4_CO2_k_hyd_xchm, SI_Ch4_CO2_k_hyd_xchs, SI_Ch4_CO2_k_hyd_xprr, SI_Ch4_CO2_k_hyd_xprs, SI_Ch4_CO2_k_hyd_xli, SI_Ch4_CO2_k_m_su, SI_Ch4_CO2_k_m_aa, SI_Ch4_CO2_k_m_c4, SI_Ch4_CO2_k_m_pro, SI_Ch4_CO2_k_m_ac, SI_Ch4_CO2_k_s_ac, SI_Ch4_CO2_Ki_nh3_ac, SI_Ch4_CO2_kla, SI_Ch4_CO2_Ki_hac_ac, SI_Ch4_CO2_Ki_hpro, SI_Ch4_CO2_k_m_h2, SI_Ch4_CO2_Ki_h2_c4, SI_Ch4_CO2_Ki_h2_pro, SI_Ch4_CO2_Ks_c4, SI_Ch4_CO2_Ks_h2, SI_Ch4_CO2_Ks_pro, SI_Ch4_CO2_Ks_su;
    Real SI_pH_k_hyd_xchr, SI_pH_k_hyd_xchm, SI_pH_k_hyd_xchs, SI_pH_k_hyd_xprr, SI_pH_k_hyd_xprs, SI_pH_k_hyd_xli, SI_pH_k_m_su, SI_pH_k_m_aa, SI_pH_k_m_c4, SI_pH_k_m_pro, SI_pH_k_m_ac, SI_pH_k_s_ac, SI_pH_Ki_nh3_ac, SI_pH_kla, SI_pH_Ki_hac_ac, SI_pH_Ki_hpro_pro;
  equation
//Compute minimum of a methane content (QoI)
//xch4_min = min(pilot.uit.Gas_Meter.x_ch4,xch4_min);
//
//Local OAT sensitivity index on Qch4
    SI_Qch4_k_hyd_xchr = -pilot.uit.digester.k_hyd_xchr*(pilot.uit.y_gas[4] - pilot_k_hyd_xchr.uit.y_gas[4])/(pilot.uit.digester.k_hyd_xchr - pilot_k_hyd_xchr.uit.digester.k_hyd_xchr)/pilot.uit.y_gas[4];
    SI_Qch4_k_hyd_xchm = -pilot.uit.digester.k_hyd_xchm*(pilot.uit.y_gas[4] - pilot_k_hyd_xchm.uit.y_gas[4])/(pilot.uit.digester.k_hyd_xchm - pilot_k_hyd_xchm.uit.digester.k_hyd_xchm)/pilot.uit.y_gas[4];
    SI_Qch4_k_hyd_xchs = -pilot.uit.digester.k_hyd_xchs*(pilot.uit.y_gas[4] - pilot_k_hyd_xchs.uit.y_gas[4])/(pilot.uit.digester.k_hyd_xchs - pilot_k_hyd_xchs.uit.digester.k_hyd_xchs)/pilot.uit.y_gas[4];
    SI_Qch4_k_hyd_xprr = -pilot.uit.digester.k_hyd_xprr*(pilot.uit.y_gas[4] - pilot_k_hyd_xprr.uit.y_gas[4])/(pilot.uit.digester.k_hyd_xprr - pilot_k_hyd_xprr.uit.digester.k_hyd_xprr)/pilot.uit.y_gas[4];
    SI_Qch4_k_hyd_xprs = -pilot.uit.digester.k_hyd_xprs*(pilot.uit.y_gas[4] - pilot_k_hyd_xprs.uit.y_gas[4])/(pilot.uit.digester.k_hyd_xprs - pilot_k_hyd_xprs.uit.digester.k_hyd_xprs)/pilot.uit.y_gas[4];
    SI_Qch4_k_hyd_xli = -pilot.uit.digester.k_hyd_xli*(pilot.uit.y_gas[4] - pilot_k_hyd_xli.uit.y_gas[4])/(pilot.uit.digester.k_hyd_xli - pilot_k_hyd_xli.uit.digester.k_hyd_xli)/pilot.uit.y_gas[4];
    SI_Qch4_k_m_su = -pilot.uit.digester.k_m_su*(pilot.uit.y_gas[4] - pilot_km_su.uit.y_gas[4])/(pilot.uit.digester.k_m_su - pilot_km_su.uit.digester.k_m_su)/pilot.uit.y_gas[4];
    SI_Qch4_k_m_aa = -pilot.uit.digester.k_m_aa*(pilot.uit.y_gas[4] - pilot_km_aa.uit.y_gas[4])/(pilot.uit.digester.k_m_aa - pilot_km_aa.uit.digester.k_m_aa)/pilot.uit.y_gas[4];
    SI_Qch4_k_m_c4 = -pilot.uit.digester.k_m_c4*(pilot.uit.y_gas[4] - pilot_km_c4.uit.y_gas[4])/(pilot.uit.digester.k_m_c4 - pilot_km_c4.uit.digester.k_m_c4)/pilot.uit.y_gas[4];
    SI_Qch4_k_m_pro = -pilot.uit.digester.k_m_pro*(pilot.uit.y_gas[4] - pilot_km_pro.uit.y_gas[4])/(pilot.uit.digester.k_m_pro - pilot_km_pro.uit.digester.k_m_pro)/pilot.uit.y_gas[4];
    SI_Qch4_k_m_ac = -pilot.uit.digester.k_m_ac*(pilot.uit.y_gas[4] - pilot_km_ac.uit.y_gas[4])/(pilot.uit.digester.k_m_ac - pilot_km_ac.uit.digester.k_m_ac)/pilot.uit.y_gas[4];
    SI_Qch4_k_s_ac = -pilot.uit.digester.Ks_ac*(pilot.uit.y_gas[4] - pilot_ks_ac.uit.y_gas[4])/(pilot.uit.digester.Ks_ac - pilot_ks_ac.uit.digester.Ks_ac)/pilot.uit.y_gas[4];
    SI_Qch4_Ki_nh3_ac = -pilot.uit.digester.Ki_nh3_ac*(pilot.uit.y_gas[4] - pilot_ki_nh3.uit.y_gas[4])/(pilot.uit.digester.Ki_nh3_ac - pilot_ki_nh3.uit.digester.Ki_nh3_ac)/pilot.uit.y_gas[4];
    SI_Qch4_kla = -pilot.uit.digester.kla*(pilot.uit.y_gas[4] - pilot_kla.uit.y_gas[4])/(pilot.uit.digester.kla - pilot_kla.uit.digester.kla)/pilot.uit.y_gas[4];
    SI_Qch4_Ki_hac_ac = -pilot.uit.digester.Ki_hac_ac*(pilot.uit.y_gas[4] - pilot_ki_hac.uit.y_gas[4])/(pilot.uit.digester.Ki_hac_ac - pilot_ki_hac.uit.digester.Ki_hac_ac)/pilot.uit.y_gas[4];
    SI_Qch4_Ki_hpro_pro = -pilot.uit.digester.Ki_hpro_pro*(pilot.uit.y_gas[4] - pilot_ki_hpro.uit.y_gas[4])/(pilot.uit.digester.Ki_hpro_pro - pilot_ki_hpro.uit.digester.Ki_hpro_pro)/pilot.uit.y_gas[4];
    SI_Qch4_k_m_h2 = -pilot.uit.digester.k_m_h2*(pilot.uit.y_gas[4] - pilot_k_m_h2.uit.y_gas[4])/(pilot.uit.digester.k_m_h2 - pilot_k_m_h2.uit.digester.k_m_h2)/pilot.uit.y_gas[4];
    SI_Qch4_Ki_h2_c4 = -pilot.uit.digester.Ki_h2_c4*(pilot.uit.y_gas[4] - pilot_Ki_h2_c4.uit.y_gas[4])/(pilot.uit.digester.Ki_h2_c4 - pilot_Ki_h2_c4.uit.digester.Ki_h2_c4)/pilot.uit.y_gas[4];
    SI_Qch4_Ki_h2_pro = -pilot.uit.digester.Ki_h2_pro*(pilot.uit.y_gas[4] - pilot_Ki_h2_pro.uit.y_gas[4])/(pilot.uit.digester.Ki_h2_pro - pilot_Ki_h2_pro.uit.digester.Ki_h2_pro)/pilot.uit.y_gas[4];
    SI_Qch4_Ks_c4 = -pilot.uit.digester.Ks_c4*(pilot.uit.y_gas[4] - pilot_Ks_c4.uit.y_gas[4])/(pilot.uit.digester.Ks_c4 - pilot_Ks_c4.uit.digester.Ks_c4)/pilot.uit.y_gas[4];
    SI_Qch4_Ks_h2 = -pilot.uit.digester.Ks_h2*(pilot.uit.y_gas[4] - pilot_Ks_h2.uit.y_gas[4])/(pilot.uit.digester.Ks_h2 - pilot_Ks_h2.uit.digester.Ks_h2)/pilot.uit.y_gas[4];
    SI_Qch4_Ks_pro = -pilot.uit.digester.Ks_pro*(pilot.uit.y_gas[4] - pilot_Ks_pro.uit.y_gas[4])/(pilot.uit.digester.Ks_pro - pilot_Ks_pro.uit.digester.Ks_pro)/pilot.uit.y_gas[4];
    SI_Qch4_Ks_su = -pilot.uit.digester.Ks_su*(pilot.uit.y_gas[4] - pilot_Ks_su.uit.y_gas[4])/(pilot.uit.digester.Ks_su - pilot_Ks_su.uit.digester.Ks_su)/pilot.uit.y_gas[4];
//
//Local OAT sensitivity index on TVFA
    SI_VFA_k_hyd_xchr = -pilot.uit.digester.k_hyd_xchr*(pilot.uit.digester.TVFA - pilot_k_hyd_xchr.uit.digester.TVFA)/(pilot.uit.digester.k_hyd_xchr - pilot_k_hyd_xchr.uit.digester.k_hyd_xchr)/pilot.uit.digester.TVFA;
    SI_VFA_k_hyd_xchm = -pilot.uit.digester.k_hyd_xchm*(pilot.uit.digester.TVFA - pilot_k_hyd_xchm.uit.digester.TVFA)/(pilot.uit.digester.k_hyd_xchm - pilot_k_hyd_xchm.uit.digester.k_hyd_xchm)/pilot.uit.digester.TVFA;
    SI_VFA_k_hyd_xchs = -pilot.uit.digester.k_hyd_xchs*(pilot.uit.digester.TVFA - pilot_k_hyd_xchs.uit.digester.TVFA)/(pilot.uit.digester.k_hyd_xchs - pilot_k_hyd_xchs.uit.digester.k_hyd_xchs)/pilot.uit.digester.TVFA;
    SI_VFA_k_hyd_xprr = -pilot.uit.digester.k_hyd_xprr*(pilot.uit.digester.TVFA - pilot_k_hyd_xprr.uit.digester.TVFA)/(pilot.uit.digester.k_hyd_xprr - pilot_k_hyd_xprr.uit.digester.k_hyd_xprr)/pilot.uit.digester.TVFA;
    SI_VFA_k_hyd_xprs = -pilot.uit.digester.k_hyd_xprs*(pilot.uit.digester.TVFA - pilot_k_hyd_xprs.uit.digester.TVFA)/(pilot.uit.digester.k_hyd_xprs - pilot_k_hyd_xprs.uit.digester.k_hyd_xprs)/pilot.uit.digester.TVFA;
    SI_VFA_k_hyd_xli = -pilot.uit.digester.k_hyd_xli*(pilot.uit.digester.TVFA - pilot_k_hyd_xli.uit.digester.TVFA)/(pilot.uit.digester.k_hyd_xli - pilot_k_hyd_xli.uit.digester.k_hyd_xli)/pilot.uit.digester.TVFA;
    SI_VFA_k_m_su = -pilot.uit.digester.k_m_su*(pilot.uit.digester.TVFA - pilot_km_su.uit.digester.TVFA)/(pilot.uit.digester.k_m_su - pilot_km_su.uit.digester.k_m_su)/pilot.uit.digester.TVFA;
    SI_VFA_k_m_aa = -pilot.uit.digester.k_m_aa*(pilot.uit.digester.TVFA - pilot_km_aa.uit.digester.TVFA)/(pilot.uit.digester.k_m_aa - pilot_km_aa.uit.digester.k_m_aa)/pilot.uit.digester.TVFA;
    SI_VFA_k_m_c4 = -pilot.uit.digester.k_m_c4*(pilot.uit.digester.TVFA - pilot_km_c4.uit.digester.TVFA)/(pilot.uit.digester.k_m_c4 - pilot_km_c4.uit.digester.k_m_c4)/pilot.uit.digester.TVFA;
    SI_VFA_k_m_pro = -pilot.uit.digester.k_m_pro*(pilot.uit.digester.TVFA - pilot_km_pro.uit.digester.TVFA)/(pilot.uit.digester.k_m_pro - pilot_km_pro.uit.digester.k_m_pro)/pilot.uit.digester.TVFA;
    SI_VFA_k_m_ac = -pilot.uit.digester.k_m_ac*(pilot.uit.digester.TVFA - pilot_km_ac.uit.digester.TVFA)/(pilot.uit.digester.k_m_ac - pilot_km_ac.uit.digester.k_m_ac)/pilot.uit.digester.TVFA;
    SI_VFA_k_s_ac = -pilot.uit.digester.Ks_ac*(pilot.uit.digester.TVFA - pilot_ks_ac.uit.digester.TVFA)/(pilot.uit.digester.Ks_ac - pilot_ks_ac.uit.digester.Ks_ac)/pilot.uit.digester.TVFA;
    SI_VFA_Ki_nh3_ac = -pilot.uit.digester.Ki_nh3_ac*(pilot.uit.digester.TVFA - pilot_ki_nh3.uit.digester.TVFA)/(pilot.uit.digester.Ki_nh3_ac - pilot_ki_nh3.uit.digester.Ki_nh3_ac)/pilot.uit.digester.TVFA;
    SI_VFA_kla = -pilot.uit.digester.kla*(pilot.uit.digester.TVFA - pilot_kla.uit.digester.TVFA)/(pilot.uit.digester.kla - pilot_kla.uit.digester.kla)/pilot.uit.digester.TVFA;
    SI_VFA_Ki_hac_ac = -pilot.uit.digester.Ki_hac_ac*(pilot.uit.digester.TVFA - pilot_ki_hac.uit.digester.TVFA)/(pilot.uit.digester.Ki_hac_ac - pilot_ki_hac.uit.digester.Ki_hac_ac)/pilot.uit.digester.TVFA;
    SI_VFA_Ki_hpro = -pilot.uit.digester.Ki_hpro_pro*(pilot.uit.digester.TVFA - pilot_ki_hpro.uit.digester.TVFA)/(pilot.uit.digester.Ki_hpro_pro - pilot_ki_hpro.uit.digester.Ki_hpro_pro)/pilot.uit.digester.TVFA;
    SI_VFA_k_m_h2 = -pilot.uit.digester.k_m_h2*(pilot.uit.digester.TVFA - pilot_k_m_h2.uit.digester.TVFA)/(pilot.uit.digester.k_m_h2 - pilot_k_m_h2.uit.digester.k_m_h2)/pilot.uit.digester.TVFA;
    SI_VFA_Ki_h2_c4 = -pilot.uit.digester.Ki_h2_c4*(pilot.uit.digester.TVFA - pilot_Ki_h2_c4.uit.digester.TVFA)/(pilot.uit.digester.Ki_h2_c4 - pilot_Ki_h2_c4.uit.digester.Ki_h2_c4)/pilot.uit.digester.TVFA;
    SI_VFA_Ki_h2_pro = -pilot.uit.digester.Ki_h2_pro*(pilot.uit.digester.TVFA - pilot_Ki_h2_pro.uit.digester.TVFA)/(pilot.uit.digester.Ki_h2_pro - pilot_Ki_h2_pro.uit.digester.Ki_h2_pro)/pilot.uit.digester.TVFA;
    SI_VFA_Ks_c4 = -pilot.uit.digester.Ks_c4*(pilot.uit.digester.TVFA - pilot_Ks_c4.uit.digester.TVFA)/(pilot.uit.digester.Ks_c4 - pilot_Ks_c4.uit.digester.Ks_c4)/pilot.uit.digester.TVFA;
    SI_VFA_Ks_h2 = -pilot.uit.digester.Ks_h2*(pilot.uit.digester.TVFA - pilot_Ks_h2.uit.digester.TVFA)/(pilot.uit.digester.Ks_h2 - pilot_Ks_h2.uit.digester.Ks_h2)/pilot.uit.digester.TVFA;
    SI_VFA_Ks_pro = -pilot.uit.digester.Ks_pro*(pilot.uit.digester.TVFA - pilot_Ks_pro.uit.digester.TVFA)/(pilot.uit.digester.Ks_pro - pilot_Ks_pro.uit.digester.Ks_pro)/pilot.uit.digester.TVFA;
    SI_VFA_Ks_su = -pilot.uit.digester.Ks_su*(pilot.uit.digester.TVFA - pilot_Ks_su.uit.digester.TVFA)/(pilot.uit.digester.Ks_su - pilot_Ks_su.uit.digester.Ks_su)/pilot.uit.digester.TVFA;
//
//Local OAT sensitivity index on pH
    SI_pH_k_hyd_xchr = -pilot.uit.digester.k_hyd_xchr*(pilot.uit.digester.pH - pilot_k_hyd_xchr.uit.digester.pH)/(pilot.uit.digester.k_hyd_xchr - pilot_k_hyd_xchr.uit.digester.k_hyd_xchr)/pilot.uit.digester.pH;
    SI_pH_k_hyd_xchm = -pilot.uit.digester.k_hyd_xchm*(pilot.uit.digester.pH - pilot_k_hyd_xchm.uit.digester.pH)/(pilot.uit.digester.k_hyd_xchm - pilot_k_hyd_xchm.uit.digester.k_hyd_xchm)/pilot.uit.digester.pH;
    SI_pH_k_hyd_xchs = -pilot.uit.digester.k_hyd_xchs*(pilot.uit.digester.pH - pilot_k_hyd_xchs.uit.digester.pH)/(pilot.uit.digester.k_hyd_xchs - pilot_k_hyd_xchs.uit.digester.k_hyd_xchs)/pilot.uit.digester.pH;
    SI_pH_k_hyd_xprr = -pilot.uit.digester.k_hyd_xprr*(pilot.uit.digester.pH - pilot_k_hyd_xprr.uit.digester.pH)/(pilot.uit.digester.k_hyd_xprr - pilot_k_hyd_xprr.uit.digester.k_hyd_xprr)/pilot.uit.digester.pH;
    SI_pH_k_hyd_xprs = -pilot.uit.digester.k_hyd_xprs*(pilot.uit.digester.pH - pilot_k_hyd_xprs.uit.digester.pH)/(pilot.uit.digester.k_hyd_xprs - pilot_k_hyd_xprs.uit.digester.k_hyd_xprs)/pilot.uit.digester.pH;
    SI_pH_k_hyd_xli = -pilot.uit.digester.k_hyd_xli*(pilot.uit.digester.pH - pilot_k_hyd_xli.uit.digester.pH)/(pilot.uit.digester.k_hyd_xli - pilot_k_hyd_xli.uit.digester.k_hyd_xli)/pilot.uit.digester.pH;
    SI_pH_k_m_su = -pilot.uit.digester.k_m_su*(pilot.uit.digester.pH - pilot_km_su.uit.digester.pH)/(pilot.uit.digester.k_m_su - pilot_km_su.uit.digester.k_m_su)/pilot.uit.digester.pH;
    SI_pH_k_m_aa = -pilot.uit.digester.k_m_aa*(pilot.uit.digester.pH - pilot_km_aa.uit.digester.pH)/(pilot.uit.digester.k_m_aa - pilot_km_aa.uit.digester.k_m_aa)/pilot.uit.digester.pH;
    SI_pH_k_m_c4 = -pilot.uit.digester.k_m_c4*(pilot.uit.digester.pH - pilot_km_c4.uit.digester.pH)/(pilot.uit.digester.k_m_c4 - pilot_km_c4.uit.digester.k_m_c4)/pilot.uit.digester.pH;
    SI_pH_k_m_pro = -pilot.uit.digester.k_m_pro*(pilot.uit.digester.pH - pilot_km_pro.uit.digester.pH)/(pilot.uit.digester.k_m_pro - pilot_km_pro.uit.digester.k_m_pro)/pilot.uit.digester.pH;
    SI_pH_k_m_ac = -pilot.uit.digester.k_m_ac*(pilot.uit.digester.pH - pilot_km_ac.uit.digester.pH)/(pilot.uit.digester.k_m_ac - pilot_km_ac.uit.digester.k_m_ac)/pilot.uit.digester.pH;
    SI_pH_k_s_ac = -pilot.uit.digester.Ks_ac*(pilot.uit.digester.pH - pilot_ks_ac.uit.digester.pH)/(pilot.uit.digester.Ks_ac - pilot_ks_ac.uit.digester.Ks_ac)/pilot.uit.digester.pH;
    SI_pH_Ki_nh3_ac = -pilot.uit.digester.Ki_nh3_ac*(pilot.uit.digester.pH - pilot_ki_nh3.uit.digester.pH)/(pilot.uit.digester.Ki_nh3_ac - pilot_ki_nh3.uit.digester.Ki_nh3_ac)/pilot.uit.digester.pH;
    SI_pH_kla = -pilot.uit.digester.kla*(pilot.uit.digester.pH - pilot_kla.uit.digester.pH)/(pilot.uit.digester.kla - pilot_kla.uit.digester.kla)/pilot.uit.digester.pH;
    SI_pH_Ki_hac_ac = -pilot.uit.digester.Ki_hac_ac*(pilot.uit.digester.pH - pilot_ki_hac.uit.digester.pH)/(pilot.uit.digester.Ki_hac_ac - pilot_ki_hac.uit.digester.Ki_hac_ac)/pilot.uit.digester.pH;
    SI_pH_Ki_hpro_pro = -pilot.uit.digester.Ki_hpro_pro*(pilot.uit.digester.pH - pilot_ki_hpro.uit.digester.pH)/(pilot.uit.digester.Ki_hpro_pro - pilot_ki_hpro.uit.digester.Ki_hpro_pro)/pilot.uit.digester.pH;
//Local OAT Sensitivity index on Ch4/CO2
    SI_Ch4_CO2_k_hyd_xchr = -pilot.uit.digester.k_hyd_xchr*((pilot.uit.y_gas[2]/pilot.uit.y_gas[3]) - (pilot_k_hyd_xchr.uit.y_gas[2]/pilot_k_hyd_xchr.uit.y_gas[3]))/(pilot.uit.digester.k_hyd_xchr - pilot_k_hyd_xchr.uit.digester.k_hyd_xchr)/(pilot.uit.y_gas[2]/pilot.uit.y_gas[3]);
    SI_Ch4_CO2_k_hyd_xchm = -pilot.uit.digester.k_hyd_xchm*((pilot.uit.y_gas[2]/pilot.uit.y_gas[3]) - (pilot_k_hyd_xchm.uit.y_gas[2]/pilot_k_hyd_xchm.uit.y_gas[3]))/(pilot.uit.digester.k_hyd_xchm - pilot_k_hyd_xchm.uit.digester.k_hyd_xchm)/(pilot.uit.y_gas[2]/pilot.uit.y_gas[3]);
    SI_Ch4_CO2_k_hyd_xchs = -pilot.uit.digester.k_hyd_xchs*((pilot.uit.y_gas[2]/pilot.uit.y_gas[3]) - (pilot_k_hyd_xchs.uit.y_gas[2]/pilot_k_hyd_xchs.uit.y_gas[3]))/(pilot.uit.digester.k_hyd_xchs - pilot_k_hyd_xchs.uit.digester.k_hyd_xchs)/(pilot.uit.y_gas[2]/pilot.uit.y_gas[3]);
    SI_Ch4_CO2_k_hyd_xprr = -pilot.uit.digester.k_hyd_xprr*((pilot.uit.y_gas[2]/pilot.uit.y_gas[3]) - (pilot_k_hyd_xprr.uit.y_gas[2]/pilot_k_hyd_xprr.uit.y_gas[3]))/(pilot.uit.digester.k_hyd_xprr - pilot_k_hyd_xprr.uit.digester.k_hyd_xprr)/(pilot.uit.y_gas[2]/pilot.uit.y_gas[3]);
    SI_Ch4_CO2_k_hyd_xprs = -pilot.uit.digester.k_hyd_xprs*((pilot.uit.y_gas[2]/pilot.uit.y_gas[3]) - (pilot_k_hyd_xprs.uit.y_gas[2]/pilot_k_hyd_xprs.uit.y_gas[3]))/(pilot.uit.digester.k_hyd_xprs - pilot_k_hyd_xprs.uit.digester.k_hyd_xprs)/(pilot.uit.y_gas[2]/pilot.uit.y_gas[3]);
    SI_Ch4_CO2_k_hyd_xli = -pilot.uit.digester.k_hyd_xli*((pilot.uit.y_gas[2]/pilot.uit.y_gas[3]) - (pilot_k_hyd_xli.uit.y_gas[2]/pilot_k_hyd_xli.uit.y_gas[3]))/(pilot.uit.digester.k_hyd_xli - pilot_k_hyd_xli.uit.digester.k_hyd_xli)/(pilot.uit.y_gas[2]/pilot.uit.y_gas[3]);
    SI_Ch4_CO2_k_m_su = -pilot.uit.digester.k_m_su*((pilot.uit.y_gas[2]/pilot.uit.y_gas[3]) - (pilot_km_su.uit.y_gas[2]/pilot_km_su.uit.y_gas[3]))/(pilot.uit.digester.k_m_su - pilot_km_su.uit.digester.k_m_su)/(pilot.uit.y_gas[2]/pilot.uit.y_gas[3]);
    SI_Ch4_CO2_k_m_aa = -pilot.uit.digester.k_m_aa*((pilot.uit.y_gas[2]/pilot.uit.y_gas[3]) - (pilot_km_aa.uit.y_gas[2]/pilot_km_aa.uit.y_gas[3]))/(pilot.uit.digester.k_m_aa - pilot_km_aa.uit.digester.k_m_aa)/(pilot.uit.y_gas[2]/pilot.uit.y_gas[3]);
    SI_Ch4_CO2_k_m_c4 = -pilot.uit.digester.k_m_c4*((pilot.uit.y_gas[2]/pilot.uit.y_gas[3]) - (pilot_km_c4.uit.y_gas[2]/pilot_km_c4.uit.y_gas[3]))/(pilot.uit.digester.k_m_c4 - pilot_km_c4.uit.digester.k_m_c4)/(pilot.uit.y_gas[2]/pilot.uit.y_gas[3]);
    SI_Ch4_CO2_k_m_pro = -pilot.uit.digester.k_m_pro*((pilot.uit.y_gas[2]/pilot.uit.y_gas[3]) - (pilot_km_pro.uit.y_gas[2]/pilot_km_pro.uit.y_gas[3]))/(pilot.uit.digester.k_m_pro - pilot_km_pro.uit.digester.k_m_pro)/(pilot.uit.y_gas[2]/pilot.uit.y_gas[3]);
    SI_Ch4_CO2_k_m_ac = -pilot.uit.digester.k_m_ac*((pilot.uit.y_gas[2]/pilot.uit.y_gas[3]) - (pilot_km_ac.uit.y_gas[2]/pilot_km_ac.uit.y_gas[3]))/(pilot.uit.digester.k_m_ac - pilot_km_ac.uit.digester.k_m_ac)/(pilot.uit.y_gas[2]/pilot.uit.y_gas[3]);
    SI_Ch4_CO2_k_s_ac = -pilot.uit.digester.Ks_ac*(pilot.division.y - (pilot_ks_ac.uit.y_gas[2]/pilot_ks_ac.uit.y_gas[3]))/(pilot.uit.digester.Ks_ac - pilot_ks_ac.uit.digester.Ks_ac)/pilot.division.y;
    SI_Ch4_CO2_kla = -pilot.uit.digester.kla*((pilot.uit.y_gas[2]/pilot.uit.y_gas[3]) - (pilot_kla.uit.y_gas[2]/pilot_kla.uit.y_gas[3]))/(pilot.uit.digester.kla - pilot_kla.uit.digester.kla)/(pilot.uit.y_gas[2]/pilot.uit.y_gas[3]);
    SI_Ch4_CO2_ki_nh3 = -pilot.uit.digester.ki_nh3*((pilot.uit.y_gas[2]/pilot.uit.y_gas[3]) - (pilot_ki_nh3.uit.y_gas[2]/pilot_ki_nh3.uit.y_gas[3]))/(pilot.uit.digester.ki_nh3 - pilot_ki_nh3.uit.digester.ki_nhr)/(pilot.uit.y_gas[2]/pilot.uit.y_gas[3]);
    SI_Ch4_CO2_ki_hac = -pilot.uit.digester.ki_hac*((pilot.uit.y_gas[2]/pilot.uit.y_gas[3]) - (pilot_ki_hac.uit.y_gas[2]/pilot_ki_hac.uit.y_gas[3]))/(pilot.uit.digester.ki_hac - pilot_ki_hac.uit.digester.hac)/(pilot.uit.y_gas[2]/pilot.uit.y_gas[3]);
    SI_Ch4_CO2_ki_hpro = -pilot.uit.digester.ki_hpro*((pilot.uit.y_gas[2]/pilot.uit.y_gas[3]) - (pilot_ki_hpro.uit.y_gas[2]/pilot_ki_hpro.uit.y_gas[3]))/(pilot.uit.digester.ki_hpro - pilot_ki_hpro.uit.digester.ki_hpro)/(pilot.uit.y_gas[2]/pilot.uit.y_gas[3]);
    SI_Ch4_CO2_k_m_h2 = -pilot.uit.digester.k_m_h2*((pilot.uit.y_gas[2]/pilot.uit.y_gas[3]) - (pilot_k_m_h2.uit.y_gas[2]/pilot_k_m_h2.uit.y_gas[3]))/(pilot.uit.digester.k_m_h2 - pilot_k_m_h2.uit.digester.k_m_h2)/(pilot.uit.y_gas[2]/pilot.uit.y_gas[3]);
    SI_Ch4_CO2_Ki_h2_c4 = -pilot.uit.digester.Ki_h2_c4*((pilot.uit.y_gas[2]/pilot.uit.y_gas[3]) - (pilot_Ki_h2_c4.uit.y_gas[2]/pilot_Ki_h2_c4.uit.y_gas[3]))/(pilot.uit.digester.Ki_h2_c4 - pilot_Ki_h2_c4.uit.digester.Ki_h2_c4)/(pilot.uit.y_gas[2]/pilot.uit.y_gas[3]);
    SI_Ch4_CO2_Ki_h2_pro = -pilot.uit.digester.Ki_h2_pro*((pilot.uit.y_gas[2]/pilot.uit.y_gas[3]) - (pilot_Ki_h2_pro.uit.y_gas[2]/pilot_Ki_h2_pro.uit.y_gas[3]))/(pilot.uit.digester.Ki_h2_pro - pilot_Ki_h2_pro.uit.digester.Ki_h2_pro)/(pilot.uit.y_gas[2]/pilot.uit.y_gas[3]);
    SI_Ch4_CO2_Ks_c4 = -pilot.uit.digester.Ks_c4*((pilot.uit.y_gas[2]/pilot.uit.y_gas[3]) - (pilot_Ks_c4.uit.y_gas[2]/pilot_Ks_c4.uit.y_gas[3]))/(pilot.uit.digester.Ks_c4 - pilot_Ks_c4.uit.digester.Ks_c4)/(pilot.uit.y_gas[2]/pilot.uit.y_gas[3]);
    SI_Ch4_CO2_Ks_h2 = -pilot.uit.digester.Ks_h2*((pilot.uit.y_gas[2]/pilot.uit.y_gas[3]) - (pilot_Ks_h2.uit.y_gas[2]/pilot_Ks_h2.uit.y_gas[3]))/(pilot.uit.digester.Ks_h2 - pilot_Ks_h2.uit.digester.Ks_h2)/(pilot.uit.y_gas[2]/pilot.uit.y_gas[3]);
    SI_Ch4_CO2_Ks_pro = -pilot.uit.digester.Ks_pro*((pilot.uit.y_gas[2]/pilot.uit.y_gas[3]) - (pilot_Ks_pro.uit.y_gas[2]/pilot_Ks_pro.uit.y_gas[3]))/(pilot.uit.digester.Ks_pro - pilot_Ks_pro.uit.digester.Ks_pro)/(pilot.uit.y_gas[2]/pilot.uit.y_gas[3]);
    SI_Ch4_CO2_Ks_su = -pilot.uit.digester.Ks_su*((pilot.uit.y_gas[2]/pilot.uit.y_gas[3]) - (pilot_Ks_su.uit.y_gas[2]/pilot_Ks_su.uit.y_gas[3]))/(pilot.uit.digester.Ks_su - pilot_Ks_su.uit.digester.Ks_su)/(pilot.uit.y_gas[2]/pilot.uit.y_gas[3]);
//Set missing input
    pilot.u = {0, 0, 0, 0, 0};
    pilot_k_hyd_xchr.u = {0, 0, 0, 0, 0};
    pilot_k_hyd_xchm.u = {0, 0, 0, 0, 0};
    pilot_k_hyd_xchs.u = {0, 0, 0, 0, 0};
    pilot_k_hyd_xprr.u = {0, 0, 0, 0, 0};
    pilot_k_hyd_xprs.u = {0, 0, 0, 0, 0};
    pilot_k_hyd_xli.u = {0, 0, 0, 0, 0};
    pilot_km_su.u = {0, 0, 0, 0, 0};
    pilot_km_aa.u = {0, 0, 0, 0, 0};
    pilot_km_c4.u = {0, 0, 0, 0, 0};
    pilot_km_pro.u = {0, 0, 0, 0, 0};
    pilot_km_ac.u = {0, 0, 0, 0, 0};
    pilot_ks_ac.u = {0, 0, 0, 0, 0};
    pilot_kla.u = {0, 0, 0, 0, 0};
    pilot_ki_nh3.u = {0, 0, 0, 0, 0};
    pilot_ki_hac.u = {0, 0, 0, 0, 0};
    pilot_ki_hpro.u = {0, 0, 0, 0, 0};
    pilot_k_m_h2.u = {0, 0, 0, 0, 0};
    pilot_Ki_h2_c4.u = {0, 0, 0, 0, 0};
    pilot_Ki_h2_pro.u = {0, 0, 0, 0, 0};
    pilot_Ks_c4.u = {0, 0, 0, 0, 0};
    pilot_Ks_h2.u = {0, 0, 0, 0, 0};
    pilot_Ks_pro.u = {0, 0, 0, 0, 0};
    pilot_Ks_su.u = {0, 0, 0, 0, 0};
    annotation(
      experiment(StartTime = 0, StopTime = 2.592e+06, Tolerance = 1e-06, Interval = 3600),
      __OpenModelica_commandLineOptions = "--matchingAlgorithm=PFPlusExt --indexReductionMethod=dynamicStateSelection -d=initialization,NLSanalyticJacobian --std=latest ",
      __OpenModelica_simulationFlags(lv = "LOG_STATS", s = "dassl", variableFilter = ".*"));
  end Sensitivity_process_UIT;

  model Sensitivity_influent_UIT
    //Set up on 23.11.2023 for uit.digester input uit.tomatosouce characterization parameters
    //Do the same also for maize and slurry
    //Compute QoI
    //Real xch4_min(start=1);
    //Nominal parameter values (change them according to nominal 'UIT' simulation results. Also, set them in the 'UIT' model for 'steady' simulations).
    //uit.tomatosouce redeclare f_pr_r/f_pr_s as 0.5/0.5, different from simulation for exploration purposes
    //'steady' has always to be set 'true' here, otherwise the values are not modified and taken from combiTimeTables
    parameter Boolean steady = true;
    parameter Real f_pr_r = 1;
    parameter Real f_pr_s = 0;
    parameter Real bd_hemicell = 38;
    parameter Real bd_cell = 0;
    parameter Real bd_li = 100;
    parameter Real bd_pr = 100;
    parameter Real an = 0.02;
    parameter Real protein = 7.264;
    //  parameter Real lipid = 13.620;
    parameter Real su = 37.229;
    parameter Real cellulose = 14;
    //  parameter Real hemicellulose = 27.232;
    //  parameter Real starch = 0;
    parameter Real ortop = 260;
    parameter Real tan = 0;
    parameter Real ac = 0;
    //Set parameter change
    parameter Real deltap = -0.01;
    //Set input fractioning
    UIT_OL_Jan24_onoff_gasbag pilot(uit.tomatosouce.f_pr_r = f_pr_r, uit.tomatosouce.f_pr_s = f_pr_s, uit.tomatosouce.bd_hemicell = bd_hemicell, uit.tomatosouce.bd_cell = bd_cell, uit.tomatosouce.bd_li = bd_li, uit.tomatosouce.bd_pr = bd_pr, uit.tomatosouce.tan = tan, uit.tomatosouce.an = an, uit.tomatosouce.ortop = ortop, uit.tomatosouce.ac = ac, uit.tomatosouce.su = su, uit.tomatosouce.cellulose = cellulose, uit.tomatosouce.protein = protein);
    UIT_OL_Jan24_onoff_gasbag pilot_f_pr_r(uit.tomatosouce.f_pr_r = f_pr_r*(1 + deltap), uit.tomatosouce.f_pr_s = f_pr_s, uit.tomatosouce.bd_hemicell = bd_hemicell, uit.tomatosouce.bd_cell = bd_cell, uit.tomatosouce.bd_li = bd_li, uit.tomatosouce.bd_pr = bd_pr, uit.tomatosouce.tan = tan, uit.tomatosouce.an = an, uit.tomatosouce.ortop = ortop, uit.tomatosouce.ac = ac, uit.tomatosouce.su = su, uit.tomatosouce.cellulose = cellulose, uit.tomatosouce.protein = protein);
    UIT_OL_Jan24_onoff_gasbag pilot_f_pr_s(uit.tomatosouce.f_pr_s = f_pr_s*(1 + deltap), uit.tomatosouce.f_pr_r = f_pr_r, uit.tomatosouce.bd_hemicell = bd_hemicell, uit.tomatosouce.bd_cell = bd_cell, uit.tomatosouce.bd_li = bd_li, uit.tomatosouce.bd_pr = bd_pr, uit.tomatosouce.tan = tan, uit.tomatosouce.an = an, uit.tomatosouce.ortop = ortop, uit.tomatosouce.ac = ac, uit.tomatosouce.su = su, uit.tomatosouce.cellulose = cellulose, uit.tomatosouce.protein = protein);
    UIT_OL_Jan24_onoff_gasbag pilot_bd_hemicell(uit.tomatosouce.bd_hemicell = bd_hemicell*(1 + deltap), uit.tomatosouce.f_pr_r = f_pr_r, uit.tomatosouce.f_pr_s = f_pr_s, uit.tomatosouce.bd_cell = bd_cell, uit.tomatosouce.bd_li = bd_li, uit.tomatosouce.bd_pr = bd_pr, uit.tomatosouce.tan = tan, uit.tomatosouce.an = an, uit.tomatosouce.ortop = ortop, uit.tomatosouce.ac = ac, uit.tomatosouce.su = su, uit.tomatosouce.cellulose = cellulose, uit.tomatosouce.protein = protein);
    UIT_OL_Jan24_onoff_gasbag pilot_bd_cell(uit.tomatosouce.bd_cell = bd_cell*(1 + deltap), uit.tomatosouce.f_pr_r = f_pr_r, uit.tomatosouce.f_pr_s = f_pr_s, uit.tomatosouce.bd_hemicell = bd_hemicell, uit.tomatosouce.bd_li = bd_li, uit.tomatosouce.bd_pr = bd_pr, uit.tomatosouce.tan = tan, uit.tomatosouce.an = an, uit.tomatosouce.ortop = ortop, uit.tomatosouce.ac = ac, uit.tomatosouce.su = su, uit.tomatosouce.cellulose = cellulose, uit.tomatosouce.protein = protein);
    UIT_OL_Jan24_onoff_gasbag pilot_bd_li(uit.tomatosouce.bd_li = bd_li*(1 + deltap), uit.tomatosouce.f_pr_r = f_pr_r, uit.tomatosouce.f_pr_s = f_pr_s, uit.tomatosouce.bd_hemicell = bd_hemicell, uit.tomatosouce.bd_cell = bd_cell, uit.tomatosouce.bd_pr = bd_pr, uit.tomatosouce.tan = tan, uit.tomatosouce.an = an, uit.tomatosouce.ortop = ortop, uit.tomatosouce.ac = ac, uit.tomatosouce.su = su, uit.tomatosouce.cellulose = cellulose, uit.tomatosouce.protein = protein);
    UIT_OL_Jan24_onoff_gasbag pilot_bd_pr(uit.tomatosouce.bd_pr = bd_pr*(1 + deltap), uit.tomatosouce.f_pr_r = f_pr_r, uit.tomatosouce.f_pr_s = f_pr_s, uit.tomatosouce.bd_hemicell = bd_hemicell, uit.tomatosouce.bd_cell = bd_cell, uit.tomatosouce.bd_li = bd_li, uit.tomatosouce.tan = tan, uit.tomatosouce.an = an, uit.tomatosouce.ortop = ortop, uit.tomatosouce.ac = ac, uit.tomatosouce.su = su, uit.tomatosouce.cellulose = cellulose, uit.tomatosouce.protein = protein);
    UIT_OL_Jan24_onoff_gasbag pilot_tan(uit.tomatosouce.tan = tan*(1 + deltap), uit.tomatosouce.f_pr_r = f_pr_r, uit.tomatosouce.f_pr_s = f_pr_s, uit.tomatosouce.bd_hemicell = bd_hemicell, uit.tomatosouce.bd_cell = bd_cell, uit.tomatosouce.bd_li = bd_li, uit.tomatosouce.bd_pr = bd_pr, uit.tomatosouce.an = an, uit.tomatosouce.ortop = ortop, uit.tomatosouce.ac = ac, uit.tomatosouce.su = su, uit.tomatosouce.cellulose = cellulose, uit.tomatosouce.protein = protein);
    UIT_OL_Jan24_onoff_gasbag pilot_an(uit.tomatosouce.an = an*(1 + deltap), uit.tomatosouce.f_pr_r = f_pr_r, uit.tomatosouce.f_pr_s = f_pr_s, uit.tomatosouce.bd_hemicell = bd_hemicell, uit.tomatosouce.bd_cell = bd_cell, uit.tomatosouce.bd_li = bd_li, uit.tomatosouce.bd_pr = bd_pr, uit.tomatosouce.tan = tan, uit.tomatosouce.ortop = ortop, uit.tomatosouce.ac = ac, uit.tomatosouce.su = su, uit.tomatosouce.cellulose = cellulose, uit.tomatosouce.protein = protein);
    UIT_OL_Jan24_onoff_gasbag pilot_ortop(uit.tomatosouce.ortop = ortop*(1 + deltap), uit.tomatosouce.f_pr_r = f_pr_r, uit.tomatosouce.f_pr_s = f_pr_s, uit.tomatosouce.bd_hemicell = bd_hemicell, uit.tomatosouce.bd_cell = bd_cell, uit.tomatosouce.bd_li = bd_li, uit.tomatosouce.bd_pr = bd_pr, uit.tomatosouce.tan = tan, uit.tomatosouce.an = an, uit.tomatosouce.ac = ac, uit.tomatosouce.su = su, uit.tomatosouce.cellulose = cellulose, uit.tomatosouce.protein = protein);
    UIT_OL_Jan24_onoff_gasbag pilot_ac(uit.tomatosouce.ac = ac*(1 + deltap), uit.tomatosouce.f_pr_r = f_pr_r, uit.tomatosouce.f_pr_s = f_pr_s, uit.tomatosouce.bd_hemicell = bd_hemicell, uit.tomatosouce.bd_cell = bd_cell, uit.tomatosouce.bd_li = bd_li, uit.tomatosouce.bd_pr = bd_pr, uit.tomatosouce.tan = tan, uit.tomatosouce.an = an, uit.tomatosouce.ortop = ortop, uit.tomatosouce.su = su, uit.tomatosouce.cellulose = cellulose, uit.tomatosouce.protein = protein);
    UIT_OL_Jan24_onoff_gasbag pilot_su(uit.tomatosouce.su = su*(1 + deltap), uit.tomatosouce.f_pr_r = f_pr_r, uit.tomatosouce.f_pr_s = f_pr_s, uit.tomatosouce.bd_hemicell = bd_hemicell, uit.tomatosouce.bd_cell = bd_cell, uit.tomatosouce.bd_li = bd_li, uit.tomatosouce.bd_pr = bd_pr, uit.tomatosouce.tan = tan, uit.tomatosouce.an = an, uit.tomatosouce.ortop = ortop, uit.tomatosouce.ac = ac, uit.tomatosouce.cellulose = cellulose, uit.tomatosouce.protein = protein);
    UIT_OL_Jan24_onoff_gasbag pilot_cell(uit.tomatosouce.cellulose = cellulose*(1 + deltap), uit.tomatosouce.f_pr_r = f_pr_r, uit.tomatosouce.f_pr_s = f_pr_s, uit.tomatosouce.bd_hemicell = bd_hemicell, uit.tomatosouce.bd_cell = bd_cell, uit.tomatosouce.bd_li = bd_li, uit.tomatosouce.bd_pr = bd_pr, uit.tomatosouce.tan = tan, uit.tomatosouce.an = an, uit.tomatosouce.ortop = ortop, uit.tomatosouce.ac = ac, uit.tomatosouce.su = su, uit.tomatosouce.protein = protein);
    UIT_OL_Jan24_onoff_gasbag pilot_protein(uit.tomatosouce.protein = protein*(1 + deltap), uit.tomatosouce.f_pr_r = f_pr_r, uit.tomatosouce.f_pr_s = f_pr_s, uit.tomatosouce.bd_hemicell = bd_hemicell, uit.tomatosouce.bd_cell = bd_cell, uit.tomatosouce.bd_li = bd_li, uit.tomatosouce.bd_pr = bd_pr, uit.tomatosouce.tan = tan, uit.tomatosouce.an = an, uit.tomatosouce.ortop = ortop, uit.tomatosouce.ac = ac, uit.tomatosouce.su = su, uit.tomatosouce.cellulose = cellulose);
    Real SI_Vcumch4_f_pr_r, SI_Vcumch4_f_pr_s, SI_Vcumch4_bd_hemicell, SI_Vcumch4_bd_cell, SI_Vcumch4_bd_li, SI_Vcumch4_bd_pr, SI_Vcumch4_tan, SI_Vcumch4_an, SI_Vcumch4_ortop, SI_Vcumch4_ac, SI_Vcumch4_su, SI_Vcumch4_cellulose, SI_Vcumch4_protein;
    //  Real SI_derVcumch4_f_pr_r, SI_derVcumch4_f_pr_s, SI_derVcumch4_bd_hemicell, SI_derVcumch4_bd_cell, SI_derVcumch4_bd_li, SI_derVcumch4_bd_pr, SI_derVcumch4_tan, SI_derVcumch4_an, SI_derVcumch4_ortop, SI_derVcumch4_ac, SI_derVcumch4_su, SI_derVcumch4_cell, SI_derVcumch4_protein;
  equation
//Compute minimum of a methane content (QoI)
//xch4_min = min(pilot.uit.Gas_Meter.x_ch4,xch4_min);
//Local OAT sensitivity index on CH4_cum
    SI_Vcumch4_f_pr_r = -(pilot.uit.digester.CH4_cum - pilot_f_pr_r.uit.digester.CH4_cum)/deltap/pilot.uit.digester.CH4_cum;
    SI_Vcumch4_f_pr_s = -pilot.uit.tomatosouce.f_pr_s*(pilot.uit.digester.CH4_cum - pilot_f_pr_s.uit.digester.CH4_cum)/deltap/pilot.uit.digester.CH4_cum;
    SI_Vcumch4_bd_hemicell = -pilot.uit.tomatosouce.bd_hemicell*(pilot.uit.digester.CH4_cum - pilot_bd_hemicell.uit.digester.CH4_cum)/deltap/pilot.uit.digester.CH4_cum;
    SI_Vcumch4_bd_cell = -pilot.uit.tomatosouce.bd_cell*(pilot.uit.digester.CH4_cum - pilot_bd_cell.uit.digester.CH4_cum)/deltap/pilot.uit.digester.CH4_cum;
    SI_Vcumch4_bd_li = -pilot.uit.tomatosouce.bd_li*(pilot.uit.digester.CH4_cum - pilot_bd_li.uit.digester.CH4_cum)/deltap/pilot.uit.digester.CH4_cum;
    SI_Vcumch4_bd_pr = -pilot.uit.tomatosouce.bd_pr*(pilot.uit.digester.CH4_cum - pilot_bd_pr.uit.digester.CH4_cum)/deltap/pilot.uit.digester.CH4_cum;
    SI_Vcumch4_tan = -pilot.uit.tomatosouce.tan*(pilot.uit.digester.CH4_cum - pilot_tan.uit.digester.CH4_cum)/deltap/pilot.uit.digester.CH4_cum;
    SI_Vcumch4_an = -pilot.uit.tomatosouce.an*(pilot.uit.digester.CH4_cum - pilot_an.uit.digester.CH4_cum)/deltap/pilot.uit.digester.CH4_cum;
    SI_Vcumch4_ortop = -pilot.uit.tomatosouce.ortop*(pilot.uit.digester.CH4_cum - pilot_ortop.uit.digester.CH4_cum)/deltap/pilot.uit.digester.CH4_cum;
    SI_Vcumch4_ac = -pilot.uit.tomatosouce.ac*(pilot.uit.digester.CH4_cum - pilot_ac.uit.digester.CH4_cum)/deltap/pilot.uit.digester.CH4_cum;
    SI_Vcumch4_su = -pilot.uit.tomatosouce.su*(pilot.uit.digester.CH4_cum - pilot_su.uit.digester.CH4_cum)/deltap/pilot.uit.digester.CH4_cum;
    SI_Vcumch4_cellulose = -pilot.uit.tomatosouce.cellulose*(pilot.uit.digester.CH4_cum - pilot_cell.uit.digester.CH4_cum)/deltap/pilot.uit.digester.CH4_cum;
    SI_Vcumch4_protein = -pilot.uit.tomatosouce.protein*(pilot.uit.digester.CH4_cum - pilot_protein.uit.digester.CH4_cum)/deltap/pilot.uit.digester.CH4_cum;
//
//Set missing input
    pilot.u = {0, 0, 0, 0, 0};
    pilot_f_pr_r.u = {0, 0, 0, 0, 0};
    pilot_f_pr_s.u = {0, 0, 0, 0, 0};
    pilot_bd_cell.u = {0, 0, 0, 0, 0};
    pilot_bd_hemicell.u = {0, 0, 0, 0, 0};
    pilot_bd_li.u = {0, 0, 0, 0, 0};
    pilot_bd_pr.u = {0, 0, 0, 0, 0};
    pilot_tan.u = {0, 0, 0, 0, 0};
    pilot_an.u = {0, 0, 0, 0, 0};
    pilot_ortop.u = {0, 0, 0, 0, 0};
    pilot_ac.u = {0, 0, 0, 0, 0};
    pilot_su.u = {0, 0, 0, 0, 0};
    pilot_cell.u = {0, 0, 0, 0, 0};
    pilot_protein.u = {0, 0, 0, 0, 0};
    annotation(
      experiment(StartTime = 0, StopTime = 2.592e+06, Tolerance = 1e-06, Interval = 3600),
      __OpenModelica_commandLineOptions = "--matchingAlgorithm=PFPlusExt --indexReductionMethod=dynamicStateSelection -d=initialization,NLSanalyticJacobian --std=latest ",
      __OpenModelica_simulationFlags(lv = "LOG_STATS", s = "dassl", variableFilter = ".*"));
  end Sensitivity_influent_UIT;

  model Sensitivity_Sobol_UIT
    //Set up on 23.11.2023 for uit.digester process parameters
    //Compute QoI
    //Real xch4_min(start=1);
    //Nominal parameter values
    //Add other Ks, Ki and kd!!
    parameter Real k_hyd_xchr = 1 "0.32566743895306743, 0.45, 1";
    parameter Real k_hyd_xchm = 0.3 "0.42319302147680693 0.28,0.3";
    parameter Real k_hyd_xchs = 0.01 "0.016324478692379397 0.011, 0.01";
    parameter Real k_hyd_xprr = 1 "0.7448677043180438 1.24, 1";
    parameter Real k_hyd_xprs = 0.2 "0.21758908555328108 0.19, 0.2";
    parameter Real k_hyd_xli = 0.3 "0.35010790985270795 0.449, 0.3";
    parameter Real k_m_su = 30 "7.875631490240984 11, 30";
    parameter Real k_m_aa = 50 "12.535480801087115 10, 50";
    parameter Real k_m_c4 = 20 "16.696872722083715 14, 20";
    parameter Real k_m_pro = 13 "14.961292134394824 18.9, 13";
    parameter Real k_m_ac = 8 "3.2111508857602047 5.1, 5.6, 8";
    parameter Real Ks_ac = 0.15 "0.21231036725029 0.443583441 , 0.15";
    parameter Real Ki_nh3_ac = 0.0018 "0.00140997793843472 0.00125268, 0.0071428571";
    parameter Real Ki_hac_ac = 50 "2.9917458204406238 8.06841945 , 2.2";
    parameter Real Ki_hpro_pro = 50 "7.08317113463713 2.2, 2.2";
    parameter Real kla_pilot = 10 "3.185356158754692 5.821084588, 10";
    parameter Real kla_batch = 10 "12.243650647046891 10,10";
    parameter Real k_m_h2 = 35 "54.19240185230841 35";
    //Added on 17.01.2024
    parameter Real Ks_pro = 0.15 "0.7397859560206168 0.5, 0.15";
    //Added on 22.01.2024
    parameter Real Ks_h2 = 7e-6 "1.119241977682233e-05 6.88E-06, 7e-6";
    parameter Real Ks_c4 = 0.2 "0.14862982759843518 0.244986962, 0.1, 0.2";
    parameter Real Ki_h2_pro = 3.5e-6 "5.650678716932053e-06 4.65E-06, 3.5e-6";
    parameter Boolean impulse = true;
    parameter Boolean real = true;
    //Set input fractioning: Do the sensitivity as a fuction of feed_ratio and liquidcontrol_ratio?
    //With ks_pro
    UIT_OL_Jan24_onoff_gasbag nominal(uit.digester.k_hyd_xchr = k_hyd_xchr, uit.digester.k_hyd_xchm = k_hyd_xchm, uit.digester.k_hyd_xchs = k_hyd_xchs, uit.digester.k_hyd_xprr = k_hyd_xprr, uit.digester.k_hyd_xprs = k_hyd_xprs, uit.digester.k_hyd_xli = k_hyd_xli, uit.digester.k_m_su = k_m_su, uit.digester.k_m_aa = k_m_aa, uit.digester.k_m_c4 = k_m_c4, uit.digester.k_m_pro = k_m_pro, uit.digester.k_m_ac = k_m_ac, uit.digester.Ks_ac = Ks_ac, uit.digester.Ki_nh3_ac = Ki_nh3_ac, uit.digester.Ki_hac_ac = Ki_hac_ac, uit.digester.Ki_hpro_pro = Ki_hpro_pro, uit.digester.kla = kla_pilot, uit.digester.k_m_h2 = k_m_h2, uit.digester.Ks_pro = Ks_pro, uit.digester.Ks_h2 = Ks_h2, uit.digester.Ks_c4 = Ks_c4, uit.digester.Ki_h2_pro = Ki_h2_pro, impulse = impulse, real = real);
  equation
//Set missing input
    nominal.u = {0, 0, 0, 0, 0};
    annotation(
      experiment(StartTime = 0, StopTime = 7.776e+06, Tolerance = 1e-06, Interval = 3600),
      __OpenModelica_commandLineOptions = "--matchingAlgorithm=PFPlusExt --indexReductionMethod=dynamicStateSelection -d=initialization,NLSanalyticJacobian --std=latest ",
      __OpenModelica_simulationFlags(lv = "LOG_STATS", s = "dassl", variableFilter = ".*"));
  end Sensitivity_Sobol_UIT;

  model Sensitivity_Sobol_UIT_selector
    //Set up on 11.12.2023 for "UIT_real_CL_selector_ratio_mine" UIT selector controller
    //Compute QoI
    //Real xch4_min(start=1);
    Real ISE_e(start = 0);
    Real ISE_u(start = 0);
    //Parameters to be modified
    //Nominal parameter values
    parameter Real Ti1 = 1e5;
    parameter Real Ti2 = 1e5 "Ki = kp/Ti";
    parameter Real kp1 = 0.005;
    parameter Real kp2 = 0.01;
    parameter Real ZOH = 3600/2 "?";
    parameter Real height_y1_set = 0.1;
    //0.1;
    parameter Real duration_y1_set = 1e6;
    //2e6;
    parameter Real height_y2_set = 1/1.17926;
    //1.18198;
    parameter Real hyst_uLow = 1/1.1;
    //1/1.05
    parameter Real hyst_uHigh = 1/0.95;
    //1
    //Process parameters
    parameter Real k_hyd_xchr = 1;
    parameter Real k_hyd_xchm = 0.3;
    parameter Real k_hyd_xchs = 0.01;
    parameter Real k_hyd_xprr = 1;
    parameter Real k_hyd_xprs = 0.2;
    parameter Real k_hyd_xli = 0.3;
    parameter Real k_m_su = 11;
    parameter Real k_m_aa = 10;
    parameter Real k_m_c4 = 14;
    parameter Real k_m_pro = 13;
    parameter Real k_m_ac = 5.6;
    parameter Real Ks_ac = 0.15;
    parameter Real Ki_nh3_ac = 0.0018;
    //0.0018  0.0071428571;
    parameter Real Ki_hac_ac = 2.2;
    parameter Real Ki_hpro_pro = 2.2;
    parameter Real kla = 10;
    parameter Boolean impulse = true;
    //Set input fractioning: Do the sensitivity as a fuction of feed_ratio and liquidcontrol_ratio?
    //
    UIT_real_CL_selector_ratio_mine selector(uit_ol.impulse = impulse, uit_ol.uit.digester.X_su_start = 2.45026, uit_ol.uit.digester.X_aa_start = 0.642099, uit_ol.uit.digester.X_fa_start = 0.217664, uit_ol.uit.digester.X_c4_start = 0.484566, uit_ol.uit.digester.X_pro_start = 0.300024, uit_ol.uit.digester.X_ac_start = 1.2262, uit_ol.uit.digester.X_h2_start = 0.583586, uit_ol.uit.digester.X_c_start = 0, uit_ol.uit.digester.X_i_start = 30.2866, uit_ol.uit.digester.X_ch_start = {1.01714, 0.961277, 3.56827}, uit_ol.uit.digester.X_pr_start = {0.277166, 0.849485}, uit_ol.uit.digester.X_li_start = 0.680653, uit_ol.uit.digester.X_p_start = 0.441202, uit_ol.uit.digester.S_i_start = 0.110301, uit_ol.uit.digester.S_su_start = 0.031265, uit_ol.uit.digester.S_aa_start = 0.0331616, uit_ol.uit.digester.S_fa_start = 0.0600327, uit_ol.uit.digester.S_va_start = 0.00515174, uit_ol.uit.digester.S_bu_start = 0.00886531, uit_ol.uit.digester.S_pro_start = 0.0697662, uit_ol.uit.digester.S_ac_start = 0.240605, uit_ol.uit.digester.S_h2_start = 8.68436e-07, uit_ol.uit.digester.S_ch4_start = 0.317367, uit_ol.uit.digester.S_ic_start = 0.212487, uit_ol.uit.digester.S_in_start = 0.128729, uit_ol.uit.digester.S_ip_start = 0.00309532, uit_ol.uit.digester.S_cat_start = 0.101077, uit_ol.uit.digester.S_ca_start = 4.98125e-05, uit_ol.uit.digester.S_mg_start = 0.000137233, uit_ol.uit.digester.S_an_start = 0.01696, uit_ol.uit.digester.ash_start = 14.2056, uit_ol.uit.digester.X_lig_start = 8.82497, uit_ol.uit.digester.S_gas_h2_start = 5.81582e-06, uit_ol.uit.digester.S_gas_ch4_start = 1.26012, uit_ol.uit.digester.S_gas_co2_start = 0.0166964, uit_ol.uit.digester.S_gas_nh3_start = 2.13683e-06, uit_ol.uit.digester.X_acp_start = 1.43722e-11, uit_ol.uit.digester.X_stru_start = 0.00934901, uit_ol.uit.digester.X_ccm_start = 0.00499019, uit_ol.uit.digester.X_mag_start = 4.01861e-09, uit_ol.uit.limPID.xi_start = 0.0276888, uit_ol.Qch4_bar.k = 0.455709, uit_ol.gasquality_bar.k = 1.17926, uit_ol.pH_bar.k = 7.3316, uit_ol.uit.digester.k_hyd_xchr = k_hyd_xchr, uit_ol.uit.digester.k_hyd_xchm = k_hyd_xchm, uit_ol.uit.digester.k_hyd_xchs = k_hyd_xchs, uit_ol.uit.digester.k_hyd_xprr = k_hyd_xprr, uit_ol.uit.digester.k_hyd_xprs = k_hyd_xprs, uit_ol.uit.digester.k_hyd_xli = k_hyd_xli, uit_ol.uit.digester.k_m_su = k_m_su, uit_ol.uit.digester.k_m_aa = k_m_aa, uit_ol.uit.digester.k_m_c4 = k_m_c4, uit_ol.uit.digester.k_m_pro = k_m_pro, uit_ol.uit.digester.k_m_ac = k_m_ac, uit_ol.uit.digester.Ks_ac = Ks_ac, uit_ol.uit.digester.Ki_nh3_ac = Ki_nh3_ac, uit_ol.uit.digester.Ki_hac_ac = Ki_hac_ac, uit_ol.uit.digester.Ki_hpro_pro = Ki_hpro_pro, header.Ki = kp1/Ti1, follower.Ki = kp2/Ti2, header.Kp = kp1, follower.Kp = kp2, hysteresisComparator.uLow = hyst_uLow, hysteresisComparator.uHigh = hyst_uHigh, height_y1_set = height_y1_set, duration_y1_set = duration_y1_set, y2_set.offset = height_y2_set, zeroOrderHold.samplePeriod = ZOH, zeroOrderHold1.samplePeriod = ZOH);
  equation
//Objective function for minimization of the tracking error of methane production
    der(ISE_e) = (selector.y1_set - selector.uit_ol.Qch4.y)^2;
    der(ISE_u) = selector.uit_ol.uit.q[1];
    annotation(
      experiment(StartTime = 0, StopTime = 5.184e+06, Tolerance = 1e-06, Interval = 3600),
      __OpenModelica_commandLineOptions = "--matchingAlgorithm=PFPlusExt --indexReductionMethod=dynamicStateSelection -d=initialization,NLSanalyticJacobian --std=latest ",
      __OpenModelica_simulationFlags(lv = "LOG_STATS", s = "dassl", variableFilter = ".*"));
  end Sensitivity_Sobol_UIT_selector;

  model Multiple_Selector
    Sensitivity_Sobol_UIT_selector acidified(duration_y1_set = 0, height_y1_set = 0.5) annotation(
