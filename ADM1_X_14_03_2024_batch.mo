  equation
//Additional inputs (as baseline% deltas = substrate_delta*substrate_bar.y)
//To do it with ramps, set   y = offset + (if time < startTime then 0 else if time < (startTime +
//duration) then (time - startTime)*height/duration else height);
    santonio_plus10maize.u[1] = if time < 1e6 then 0 else if time < (1e6 + 17.28e6) then (time - 1e6)*santonio_plus10maize.manure_delta/17.28e6 else santonio_plus10maize.manure_delta;
    santonio_plus10maize.u[2] = if time < 1e6 then 0 else if time < (1e6 + 17.28e6) then (time - 1e6)*santonio_plus10maize.slurry_delta/17.28e6 else santonio_plus10maize.slurry_delta;
