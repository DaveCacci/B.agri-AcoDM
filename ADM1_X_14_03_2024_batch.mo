  end UIT_CL;

  model UIT_OL
    //26.10.2023: New steadystate condition with new feed_ratio, liquidcontrol_ratio and new combi based on measurements.
    //14.11.2023: This model can now be run under "continous" feeding options and "impulse" (i.e. real) feeding option, setting the parameter 'impulse'.
    //09.01.2024: Calibration purpose: re-declaration of parameters to be estimated. Error is computed externally.
    //
    parameter Real feed_ratio = 0.2 "(Qpalpable-Qcontrol)/(Qpalpable-Qcontrol+Qslurry)";
    parameter Real liquidcontrol_ratio = 0.24 "Qcontrol/Qtot. Set from 15%OLR of s.Antonio OLR";
    parameter Real solid_feeding_interval = 2*86400;
    input Real pump_feeding_interval(start = 2.5*3600);
    Real tfr, tfr_pump;
    parameter Boolean impulse = true;
    parameter Boolean real = false;
    //Objective function declaration
    Real ISE(start = 0);
    parameter Real Qch4_maxgain = 10;
    //
    parameter Real meas[24, 4] = [1, 165000, 183, 730; 2, 767700, 183, 730; 3, 1044900, 122, 486; 4, 1216800, 122, 486; 5, 1369800, 183, 730; 6, 1639800, 122, 486; 7, 1812600, 122, 486; 8, 1987200, 183, 730; 9, 2239200, 122, 486; 10, 2408400, 122, 486; 11, 2599800, 183, 730; 12, 2851200, 122, 486; 13, 3024000, 122, 486; 14, 3199200, 91.5, 365; 15, 3466800, 61, 243; 16, 3627000, 122, 486; 17, 4055700, 122, 0; 18, 4056600, 0, 486; 19, 4231800, 122, 486; 20, 4406400, 183, 730; 21, 4662000, 122, 486; 22, 4833000, 122, 486; 23, 5000400, 183, 730; 24, 6480000, 122, 486];
    parameter Integer n_meas = size(combiTimeTable.table[2:end, :], 1);
    Real t_meas[n_meas] = meas[:, 2];
    Real v_meas[n_meas] = meas[:, 3];
    parameter Real table[25, 4] = [0, 0, 0, 0; meas];
    //Integer i_curr;
    //
    //Reactor model - system
    UIT uit(digester.X_su_start = 2.30253, digester.X_aa_start = 0.58842, digester.X_fa_start = 0.200007, digester.X_c4_start = 0.449131, digester.X_pro_start = 0.280706, digester.X_ac_start = 1.15432, digester.X_h2_start = 0.544998, digester.X_c_start = 0, digester.X_i_start = 27.4996, digester.X_ch_start = {0.955696, 0.90393, 3.35553}, digester.X_pr_start = {0.255591, 0.769892}, digester.X_li_start = 0.625897, digester.X_p_start = 0.412613, digester.S_i_start = 0.103153, digester.S_su_start = 0.0312607, digester.S_aa_start = 0.0261686, digester.S_fa_start = 0.060022, digester.S_va_start = 0.00511632, digester.S_bu_start = 0.00887421, digester.S_pro_start = 0.0697536, digester.S_ac_start = 0.0797636, digester.S_h2_start = 8.68318e-07, digester.S_ch4_start = 0.300413, digester.S_ic_start = 0.208188, digester.S_in_start = 0.112162, digester.S_ip_start = 0.00321926, digester.S_cat_start = 0.110979, digester.S_ca_start = 4.99332e-05, digester.S_mg_start = 0.000147696, digester.S_an_start = 0.01696, digester.ash_start = 12.7355, digester.X_lig_start = 7.77306, digester.S_gas_h2_start = 6.18637e-06, digester.S_gas_ch4_start = 1.27063, digester.S_gas_co2_start = 0.0165325, digester.S_gas_nh3_start = 1.8812e-06, digester.X_acp_start = 1.46744e-11, digester.X_stru_start = 0.00933855, digester.X_ccm_start = 0.00499007, digester.X_mag_start = 4.46837e-09, limPID.xi_start = 0.02579, real = real) annotation(
      Placement(visible = true, transformation(origin = {44, 4}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //Inputs
    //u_bar
    Modelica.Blocks.Sources.Constant slurry_bar(k = (1 - feed_ratio)*(1 - liquidcontrol_ratio)*4e-4) annotation(
      Placement(visible = true, transformation(origin = {-80, 34}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Modelica.Blocks.Sources.Constant silage_bar(k = feed_ratio*(1 - liquidcontrol_ratio)*4e-4) annotation(
      Placement(visible = true, transformation(origin = {-80, -12}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Modelica.Blocks.Sources.Constant tomatosouce_bar(k = liquidcontrol_ratio*4e-4) annotation(
      Placement(visible = true, transformation(origin = {-80, 68}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Modelica.Blocks.Sources.Constant eggpasta_bar(k = 0*(1 - feed_ratio)*(1 - liquidcontrol_ratio)*4e-4) annotation(
      Placement(visible = true, transformation(origin = {-84, -50}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Modelica.Blocks.Sources.Constant semolina_bar(k = 0*(1 - feed_ratio)*(1 - liquidcontrol_ratio)*4e-4) annotation(
      Placement(visible = true, transformation(origin = {-84, -80}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //u
    //Steps
    //    Modelica.Blocks.Sources.Step step_slurry(height = 0.0*(1 - feed_ratio)*(1 - liquidcontrol_ratio)*4e-4, offset = 0, startTime(displayUnit = "Ms") = 1000000) annotation(
    //      Placement(visible = true, transformation(origin = {-120, 24}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //  replaceable Modelica.Blocks.Sources.Step step_tomatosouce(height = 0.0*liquidcontrol_ratio*4e-4, offset = 0, startTime(displayUnit = "Ms") = 1000000) annotation(
    //    Placement(visible = true, transformation(origin = {-120, 60}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //  Modelica.Blocks.Sources.Step step_semolina(height = 0.0*feed_ratio*(1 - liquidcontrol_ratio)*4e-4, offset = 0, startTime(displayUnit = "Ms") = 1000000) annotation(
    //    Placement(visible = true, transformation(origin = {-124, -90}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //  Modelica.Blocks.Sources.Step step_eggpasta(height = 0.0*feed_ratio*(1 - liquidcontrol_ratio)*4e-4, offset = 0, startTime(displayUnit = "Ms") = 1000000) annotation(
    //    Placement(visible = true, transformation(origin = {-124, -60}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //Impulses
    //  Modelica.Blocks.Sources.Pulse step_slurry(amplitude = -0*(1 - feed_ratio)*(1 - liquidcontrol_ratio)*4e-4, nperiod = 1, period(displayUnit = "s") = 86400, startTime(displayUnit = "Ms") = 1000000, width = 3600/86400*100) annotation(
    //    Placement(visible = true, transformation(origin = {-120, 24}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //  Modelica.Blocks.Sources.Pulse step_semolina(amplitude = 86400/300*feed_ratio*(1 - liquidcontrol_ratio)*4e-4, nperiod = 1, period(displayUnit = "s") = 86400, startTime(displayUnit = "Ms") = 1000000, width = 300/86400*100) annotation(
