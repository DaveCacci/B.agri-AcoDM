    end Switch;

    model Selector_3
      //  Modelica.Blocks.Continuous.LimPID pid(k = Kp, Ti = Kp/Ki, Td = Kd/Kp, yMax = yMax) annotation(
      //    Placement(visible = true, transformation(origin = {-2, 2}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
