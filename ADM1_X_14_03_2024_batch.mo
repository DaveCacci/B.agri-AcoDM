      Placement(visible = true, transformation(origin = {-50, 20}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Modelica.Blocks.Sources.CombiTimeTable BMP_tomato(columns = integer({2}), extrapolation = Modelica.Blocks.Types.Extrapolation.NoExtrapolation, fileName = "C:/Users/lenovo/OneDrive - Politecnico di Milano/Work_cloud/DOTTORATO/Modelling/Pilot_plant/BMP_tomato_lug2023.txt", smoothness = Modelica.Blocks.Types.Smoothness.ConstantSegments, tableName = "BMP_tomato", tableOnFile = true, timeScale = 86400, verboseExtrapolation = true) annotation(
