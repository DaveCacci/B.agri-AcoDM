    connect(limPID.y, digester.u) annotation(
      Line(points = {{20, 68}, {42, 68}, {42, 30}}, color = {0, 0, 127}));
    connect(digester.P_gas, limPID.u_s) annotation(
      Line(points = {{40, 30}, {34, 30}, {34, 48}, {-14, 48}, {-14, 68}, {-4, 68}}, color = {0, 0, 127}));
    connect(comp_eggpasta.y, eggpasta.inlet) annotation(
      Line(points = {{-205, -50}, {-197, -50}, {-197, -56}, {-199, -56}}, color = {0, 0, 127}, thickness = 0.5));
    connect(slurry.T_op, temperature_feed.y) annotation(
      Line(points = {{-80, -2}, {-80, -84}, {-121, -84}}, color = {0, 0, 127}));
    connect(maize.T_op, temperature_feed.y) annotation(
      Line(points = {{-86, -54}, {-88, -54}, {-88, -84}, {-121, -84}}, color = {0, 0, 127}));
    connect(tomatosouce.T_op, temperature_feed.y) annotation(
      Line(points = {{-84, 42}, {-84, -84}, {-121, -84}}, color = {0, 0, 127}));
    connect(P_ref.y, limPID.u_m) annotation(
      Line(points = {{-68, 88}, {-24, 88}, {-24, 32}, {8, 32}, {8, 56}}, color = {0, 0, 127}));
    connect(eggpasta.T_op, temperature_feed.y) annotation(
      Line(points = {{-199.4, -57.8}, {-120.4, -57.8}, {-120.4, -83.8}}, color = {0, 0, 127}));
    connect(comp_semolina.y, semolina.inlet) annotation(
      Line(points = {{-205, -20}, {-197, -20}, {-197, -26}, {-199, -26}}, color = {0, 0, 127}, thickness = 0.5));
    connect(semolina.T_op, temperature_feed.y) annotation(
      Line(points = {{-199.4, -27.8}, {-119.4, -27.8}, {-119.4, -83.8}}, color = {0, 0, 127}));
    connect(semolina.outlet, digester.inlet) annotation(
      Line(points = {{-184, -28}, {28, -28}, {28, 22}}));
    connect(eggpasta.outlet, digester.inlet) annotation(
      Line(points = {{-184, -58}, {28, -58}, {28, 22}}));
//
    if real == true then
      connect(comp_slurry_real.y, slurry.inlet);
    else
      connect(comp_slurry.y, slurry.inlet);
    end if;
    annotation(
      experiment(StartTime = 0, StopTime = 5184000, Tolerance = 1e-06, Interval = 3600),
      __OpenModelica_commandLineOptions = "--matchingAlgorithm=PFPlusExt --indexReductionMethod=dynamicStateSelection -d=initialization,NLSanalyticJacobian --std=latest -d=stateselection -d=bltdump",
      __OpenModelica_simulationFlags(lv = "LOG_STATS", s = "dassl", variableFilter = ".*"),
