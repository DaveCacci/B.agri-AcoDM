    Modelica.Blocks.Sources.CombiTimeTable Tomato_flowrate_real(columns = {2}, extrapolation = Modelica.Blocks.Types.Extrapolation.Periodic, fileName = "C:/Users/lenovo/OneDrive - Politecnico di Milano/Work_cloud/DOTTORATO/Sperimentazione UIT/CombiTimeTables UIT/Tomato_flowrate_real_R2.txt", smoothness = Modelica.Blocks.Types.Smoothness.ConstantSegments, tableName = "Flowrates", tableOnFile = true, timeScale = 1) annotation(
      Placement(visible = true, transformation(origin = {-142, 22}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
  equation
//Simulation of real temperature drop in UIT
    uit.digester.T_op = if impulse == true then uit.realExpression.y else uit.temperature.y;
//Simulation of N2 flushing
    uit.digester.flush_flow = 0;
//Simulation of impulse feeding for "solid" substrates with timetable (weelend behaviour included)
//Used with "Manual_flowrates_real"
//    u3.u1 = if impulse and time > 1e6 then 86400/300*Manual_flowrates_real.y[1]/1e6 elseif not impulse or time < 1e6 then silage_bar.y else 1e-7;
//    u2.u1 = if impulse and time > 1e6 then 86400/300*Manual_flowrates_real.y[2]/1e6 elseif not impulse or time < 1e6 then  slurry_bar.y else 1e-7;
//Used with "Manual_flowrates"
    when sample(0, 86400) then
      tfr = time;
    end when;
    if real == true then
      u3.u1 = if impulse and time > 1e6 then 86400/300*Manual_flowrates_real.y[1]/1e6 elseif not impulse or time < 1e6 then silage_bar.y else 1e-7;
      u2.u1 = if impulse and time > 1e6 then 86400/300*Manual_flowrates_real.y[2]/1e6 elseif not impulse or time < 1e6 then slurry_bar.y else 1e-7;
      u1.u1 = if time > 1e6 then Tomato_flowrate_real.y[1]/1e6 elseif time < 1e6 then tomatosouce_bar.y else 1e-7;
    else
      u3.u1 = if (time - tfr) < 300 and impulse and time > 1e6 then 86400/300*Manual_flowrates.y[1]/1e6 elseif not impulse or time < 1e6 then silage_bar.y else 1e-7;
      u2.u1 = if (time - tfr) < 300 and impulse and time > 1e6 then 86400/300*Manual_flowrates.y[2]/1e6 elseif not impulse or time < 1e6 then slurry_bar.y else 1e-7;
      u1.u1 = if time > 1e6 then Manual_flowrates.y[3]/1e6 elseif time < 1e6 then tomatosouce_bar.y else 1e-7;
    end if;
//  if real == true then
//    u3.u1 = if impulse then 86400/300*Manual_flowrates_real.y[1]/1e6 elseif not impulse then silage_bar.y else 1e-7;
//    u2.u1 = if impulse then 86400/300*Manual_flowrates_real.y[2]/1e6 elseif not impulse then slurry_bar.y else 1e-7;
//    u1.u1 = Manual_flowrates_real.y[3]/1e6;
//  else
//    u3.u1 = if (time - tfr) < 300 and impulse then 86400/300*Manual_flowrates.y[1]/1e6 elseif not impulse then silage_bar.y else 1e-7;
//    u2.u1 = if (time - tfr) < 300 and impulse then 86400/300*Manual_flowrates.y[2]/1e6 elseif not impulse then slurry_bar.y else 1e-7;
//    u1.u1 = Manual_flowrates.y[3]/1e6;
//end if;
//
//Simulation of impulse feeding for "pumpable" substrates
//  when sample(0, pump_feeding_interval) then
//    tfr_pump = time;
//  end when;
//  if (time - tfr_pump) < 60 and impulse and time > 1e6 then
//    u1.u1 = 10/1e6*24*60;
//  elseif not impulse or time < 1e6 then
//    u1.u1 = tomatosouce_bar.y;
//  else
//    u1.u1 = 1e-7;
//  end if;
//Trick to allow for higher variability pump_feeding_interval
    if time > 1e6 then
      uit.q[1] = pump_onoff.onoff_load;
    else
      uit.q[1] = u1.y;
    end if;
//    uit.q[1] = pump_onoff.onoff_load;
//Inputs
//u=u_i allows only OL simulations with constant input=start values
//To perform OL simulations neglect equations for u and directly specify u_i=whatever or in "Multiple_UIT_OL".
    u[1] = u1.u2;
    u[2] = u2.u2;
    u[3] = u3.u2;
    u[4] = u4.u2;
    u[5] = u5.u2;
//  u3.u2 = if noEvent(time > 1e6 and time < 1e6 + 300) then 0*feed_ratio*(1 - liquidcontrol_ratio)*4e-4 else 0;
//  u3.u2 = if noEvent(time < 1e6) then 0 else pulse.y;
//Outputs
    y[1] = Qch4.y;
    y[2] = gasquality.y;
//
//Objective function for maximization of methane production
    der(ISE) = (Qch4_maxgain - Qch4.y)^2;
//
    connect(u2.y, uit.q[2]) annotation(
      Line(points = {{-33, 32}, {-33, 6}, {36, 6}}, color = {0, 0, 127}));
    connect(u3.y, uit.q[3]) annotation(
      Line(points = {{-36, -22}, {36, -22}, {36, 6}}, color = {0, 0, 127}));
    connect(uit.y_gas[4], Qch4.u1) annotation(
      Line(points = {{54, 4}, {54, 2}, {80, 2}, {80, -40}}, color = {0, 0, 127}));
    connect(Qch4_bar.y, Qch4.u2) annotation(
