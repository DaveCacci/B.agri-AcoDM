      Placement(visible = true, transformation(origin = {-126, 6}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
  equation
//Inputs
//q[i]=name_i.Q allows only OL simulations with constant input=start values
//To perform OL simulations neglect equations for q[i] and directly specify name_i.Q=whatever
    q[1] = tomatosouce.Q;
    q[2] = slurry.Q;
    q[3] = maize.Q;
    q[4] = eggpasta.Q;
    q[5] = semolina.Q;
//
//Uncomment this line to run this model!!!!!!!!!! digester.T_op = temperature.y;
//semolina.Q = 2e-5;
//Outputs
//Note: gas flowrates are converted in L/h (not in normal conditions!)
    y_gas = {digester.Q_gas*1000/24, Gas_Meter.x_ch4, Gas_Meter.x_co2, digester.Q_gas*1000/24*Gas_Meter.x_ch4};
    y_dig = {digester.pH, digester.TVFA, digester.Alk, digester.TAN, digester.VS, digester.FOS_TAC};
//Additional equationsdelate them!
//digester.T_op = temperature.y;
//
    connect(digester.Biogas_Out, Gas_Meter.Biogas_In) annotation(
      Line(points = {{50, 28}, {50, 52}}));
    connect(maize.outlet, digester.inlet) annotation(
