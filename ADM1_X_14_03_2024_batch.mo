  model UIT_OL_optim
    //Set as 'old' on 28.11.2023
    //Delete "pulse" block to speed up the simulation
    parameter Real feed_ratio = 0.2 "(Qpalpable-Qcontrol)/(Qpalpable-Qcontrol+Qslurry)";
    parameter Real liquidcontrol_ratio = 0.24 "Qcontrol/Qtot. Set from 15%OLR of s.Antonio OLR";
    //Optimization variables
    //  parameter Real tomato_delta = 0;
    //  parameter Real slurry_delta = 0;
    //  parameter Real maize_delta = 0;
    //  parameter Real eggpasta_delta = 0;
    //  parameter Real semoline_delta = 0;
    parameter Real tomato_delta = 188/1e6;
    parameter Real slurry_delta = -0.694/1e6;
    parameter Real maize_delta = -51.1/1e6;
    parameter Real eggpasta_delta = 25.7/1e6;
    parameter Real semoline_delta = 33.1/1e6;
    parameter Real tomato_duration = 1e6;
    parameter Real slurry_duration = 1e6;
    parameter Real maize_duration = 1e6;
    parameter Real eggpasta_duration = 1e6;
    parameter Real semoline_duration = 1e6;
    //
    //  Real VFA_max(start=1);
    //"Nominal" simulation
    UIT_OL uit_ol(feed_ratio = feed_ratio, liquidcontrol_ratio = liquidcontrol_ratio, impulse = false) annotation(
      Placement(visible = true, transformation(origin = {-66, 58}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //
    //
    Modelica.Blocks.Sources.Ramp ramp_tomato(duration = tomato_duration, height = tomato_delta, startTime(displayUnit = "Ms") = 1000000) annotation(
      Placement(visible = true, transformation(origin = {-130, 70}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Modelica.Blocks.Sources.Ramp ramp_slurry(duration = slurry_duration, height = slurry_delta, startTime(displayUnit = "Ms") = 1000000) annotation(
      Placement(visible = true, transformation(origin = {-130, 70}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Modelica.Blocks.Sources.Ramp ramp_maize(duration = maize_duration, height = maize_delta, startTime(displayUnit = "Ms") = 1000000) annotation(
      Placement(visible = true, transformation(origin = {-130, 70}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Modelica.Blocks.Sources.Ramp ramp_eggpasta(duration = eggpasta_duration, height = eggpasta_delta, startTime(displayUnit = "Ms") = 1000000) annotation(
      Placement(visible = true, transformation(origin = {-130, 70}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Modelica.Blocks.Sources.Ramp ramp_semoline(duration = semoline_duration, height = semoline_delta, startTime(displayUnit = "Ms") = 1000000) annotation(
      Placement(visible = true, transformation(origin = {-130, 70}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
  equation
//
// VFA_max = max(uit_ol.uit.digester.TVFA,VFA_max);
//Set missing input
//Additional inputs
    uit_ol.u[1] = ramp_tomato.y;
    uit_ol.u[2] = ramp_slurry.y;
    uit_ol.u[3] = ramp_maize.y;
    uit_ol.u[4] = ramp_eggpasta.y;
    uit_ol.u[5] = ramp_semoline.y;
    annotation(
      experiment(StartTime = 0, StopTime = 5.184e+06, Tolerance = 1e-06, Interval = 3600),
      __OpenModelica_commandLineOptions = "--matchingAlgorithm=PFPlusExt --indexReductionMethod=dynamicStateSelection -d=initialization,NLSanalyticJacobian --std=latest ",
      __OpenModelica_simulationFlags(lv = "LOG_STATS", s = "dassl", variableFilter = ".*"));
  end UIT_OL_optim;

