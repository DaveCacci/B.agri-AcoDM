    Control.Selector_3 follower(Kd = 0, Ki = 1e-7, Kp = 1e-2, header = false, positivegain = true, yMin = -95/1e6) annotation(
      Placement(visible = true, transformation(origin = {-70, -62}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    ADM1_P.Control.HysteresisComparator hysteresisComparator(pre_y_start = true, uHigh = 1/1, uLow = 1/1.05) annotation(
      Placement(visible = true, transformation(origin = {2, -2}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Boolean not_u = not hysteresisComparator.y;
    Real y1_set;
  equation
    uit_ol.u = {switch.y, 0, 0, 0, 0};
    uit_ol.y[1] = header.y;
    1/uit_ol.division.y = follower.y;
    hysteresisComparator.u = 1/uit_ol.division.y;
//
    y1_set = if time < 1e6 then 0 else if time < (1e6 + 2e6) then (time - 1e6)*0.1/2e6 else 0.1;
    header.y_set = y1_set;
//
    when noEvent(edge(hysteresisComparator.y)) then
      reinit(follower.x, (follower.u_other - follower.Kp*follower.e)/follower.Ki);
    end when;
    when noEvent(edge(not_u)) then
      reinit(header.x, (header.u_other - header.Kp*header.e)/header.Ki);
    end when;
// Add nominal pump_feeding_interval (19.01.2024 now it is an input to allow variability in UIT_OL_optim_19_01)
    uit_ol.pump_feeding_interval = 2.5*3600;
//
//
    connect(follower.u, switch.u1) annotation(
      Line(points = {{-60, -62}, {-60, -48}, {40, -48}, {40, 6}}, color = {0, 0, 127}));
    connect(follower.u, header.u_other) annotation(
      Line(points = {{-60, -62}, {-52, -62}, {-52, 34}, {-88, 34}, {-88, 52}, {-78, 52}}, color = {0, 0, 127}));
    connect(header.u, follower.u_other) annotation(
      Line(points = {{-60, 48}, {-46, 48}, {-46, -36}, {-78, -36}, {-78, -58}}, color = {0, 0, 127}));
    connect(header.u, switch.u3) annotation(
      Line(points = {{-60, 48}, {-60, 30}, {40, 30}, {40, -10}}, color = {0, 0, 127}));
    connect(y2_set.y, follower.y_set) annotation(
      Line(points = {{-117, -62}, {-80, -62}}, color = {0, 0, 127}));
//  connect(y1_set.y, header.y_set) annotation(
//    Line(points = {{-124, 48}, {-80, 48}}, color = {0, 0, 127}));
    connect(hysteresisComparator.y, switch.u2) annotation(
      Line(points = {{14, -2}, {40, -2}}, color = {255, 0, 255}));
    connect(header.bool_constraint, hysteresisComparator.y) annotation(
      Line(points = {{-78, 42}, {-94, 42}, {-94, 24}, {14, 24}, {14, -2}}, color = {255, 0, 255}));
    connect(follower.bool_constraint, hysteresisComparator.y) annotation(
      Line(points = {{-78, -68}, {-90, -68}, {-90, -82}, {14, -82}, {14, -2}}, color = {255, 0, 255}));
    annotation(
      experiment(StartTime = 0, StopTime = 5.184e+06, Tolerance = 1e-06, Interval = 3600),
      __OpenModelica_commandLineOptions = "--matchingAlgorithm=PFPlusExt --indexReductionMethod=dynamicStateSelection -d=initialization,NLSanalyticJacobian --std=latest ",
      __OpenModelica_simulationFlags(lv = "LOG_STATS", s = "dassl", variableFilter = ".*"),
      Diagram);
  end UIT_CL_selector_ratio_mine;

