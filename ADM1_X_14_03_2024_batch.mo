      Placement(visible = true, transformation(origin = {92, 34}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Modelica.Blocks.Math.Add Qch4(k2 = -1) annotation(
      Placement(visible = true, transformation(origin = {92, -46}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Modelica.Blocks.Math.Product product annotation(
      Placement(visible = true, transformation(origin = {132, -16}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Modelica.Blocks.Math.Division division annotation(
      Placement(visible = true, transformation(origin = {130, 20}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    Modelica.Blocks.Math.Add gasquality(k1 = -1) annotation(
      Placement(visible = true, transformation(origin = {174, 28}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //Additional interfaces to simply multiple CL analysis (es.continuous vs discrete vs impulse)
    Modelica.Blocks.Interfaces.RealInput u[4](each start = 0, each fixed = true) annotation(
      Placement(visible = true, transformation(origin = {-178, 0}, extent = {{-20, -20}, {20, 20}}, rotation = 0), iconTransformation(origin = {-178, 0}, extent = {{-20, -20}, {20, 20}}, rotation = 0)));
    Modelica.Blocks.Interfaces.RealOutput y[2] annotation(
      Placement(visible = true, transformation(origin = {214, 0}, extent = {{-10, -10}, {10, 10}}, rotation = 0), iconTransformation(origin = {214, 0}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
    //Modelica.Blocks.Sources.Trapezoid trapezoid(amplitude = 0.3*2*feed_ratio*(1 - liquidcontrol_ratio)*4e-4,falling = 86400 - 3600*(14 + 8), nperiod = -1, period = 86400, rising = 3600*14, startTime(displayUnit = "Ms") = 1000000, width = 3600*8)  annotation(
    //    Placement(visible = true, transformation(origin = {-208, 52}, extent = {{-10, -10}, {10, 10}}, rotation = 0)));
  equation
//Simulation of impulse feeding
//when sample(0,3*86400) then
//tfr = time;
//end when;
//if (time - tfr) < 300 then
//u3.u1 = silage_bar.y*3*86400/300;
//u2.u1 = slurry_bar.y*3*86400/300;
//else
//u3.u1 = 0;
//u2.u1 = 0;
//end if;
//Inputs
//u=u_i allows only OL simulations with constant input=start values
//To perform OL simulations neglect equations for u and directly specify u_i=whatever or in "Multiple_sAntonio_OL".
    u[1] = u1.u2;
    u[2] = u2.u2;
    u[3] = u3.u2;
    u[4] = u4.u2;
//Outputs
    y[1] = Qch4.y;
    y[2] = gasquality.y;
////Constraint to enforce constant HRT
//slurry_delta*slurry_bar.y = - maize_delta*silage_bar.y - tomatopeels_delta*tomatopeels_bar.y - manure_delta*manure_bar.y;
////Calculation of modified feeding ratios
//  manure_ratio = (manure_bar.y+manure_delta)/(manure_bar.y+manure_delta+silage_bar.y+maize_delta+slurry_bar.y+slurry_delta+tomatopeels_bar.y+tomatopeels_delta);
//  maize_ratio = (silage_bar.y+maize_delta)/(manure_bar.y+manure_delta+silage_bar.y+maize_delta+slurry_bar.y+slurry_delta+tomatopeels_bar.y+tomatopeels_delta);
//  slurry_ratio = (slurry_bar.y+slurry_delta)/(manure_bar.y+manure_delta+silage_bar.y+maize_delta+slurry_bar.y+slurry_delta+tomatopeels_bar.y+tomatopeels_delta);
//  tomatopeels_ratio = (tomatopeels_bar.y+tomatopeels_delta)/(manure_bar.y+manure_delta+silage_bar.y+maize_delta+slurry_bar.y+slurry_delta+tomatopeels_bar.y+tomatopeels_delta);
//Objective function
    der(ISE) = (Qch4_maxgain - Qch4.y)^2 + 10*(sAntonio.digester.COD_tot)^2;
//
    connect(u2.y, sAntonio.q[2]) annotation(
      Line(points = {{-33, 32}, {-33, 6}, {36, 6}}, color = {0, 0, 127}));
    connect(u3.y, sAntonio.q[3]) annotation(
      Line(points = {{-36, -22}, {36, -22}, {36, 6}}, color = {0, 0, 127}));
    connect(sAntonio.y_gas[4], Qch4.u1) annotation(
      Line(points = {{54, 4}, {54, 2}, {80, 2}, {80, -40}}, color = {0, 0, 127}));
    connect(Qch4_bar.y, Qch4.u2) annotation(
      Line(points = {{45, -52}, {80, -52}}, color = {0, 0, 127}));
    connect(pH_bar.y, pH.u1) annotation(
      Line(points = {{66, 40}, {80, 40}}, color = {0, 0, 127}));
    connect(sAntonio.y_dig[1], pH.u2) annotation(
      Line(points = {{54, -2}, {80, -2}, {80, 28}}, color = {0, 0, 127}));
    connect(sAntonio.y_gas[2], division.u1) annotation(
      Line(points = {{54, 4}, {118, 4}, {118, 26}}, color = {0, 0, 127}));
    connect(sAntonio.y_gas[3], division.u2) annotation(
      Line(points = {{54, 4}, {86, 4}, {86, 14}, {118, 14}}, color = {0, 0, 127}));
    connect(sAntonio.y_gas[1], product.u1) annotation(
      Line(points = {{54, 4}, {120, 4}, {120, -10}}, color = {0, 0, 127}));
    connect(sAntonio.y_gas[3], product.u2) annotation(
      Line(points = {{54, 4}, {120, 4}, {120, -22}}, color = {0, 0, 127}));
    connect(gasquality_bar.y, gasquality.u1) annotation(
      Line(points = {{142, 54}, {162, 54}, {162, 34}}, color = {0, 0, 127}));
    connect(division.y, gasquality.u2) annotation(
      Line(points = {{142, 20}, {162, 20}, {162, 22}}, color = {0, 0, 127}));
    connect(u1.y, sAntonio.q[1]) annotation(
      Line(points = {{-32, 62}, {36, 62}, {36, 6}}, color = {0, 0, 127}));
    connect(silage_bar.y, u3.u1) annotation(
      Line(points = {{-69, -12}, {-60, -12}, {-60, -16}}, color = {0, 0, 127}));
    connect(slurry_bar.y, u2.u1) annotation(
      Line(points = {{-69, 34}, {-62.5, 34}, {-62.5, 38}, {-56, 38}}, color = {0, 0, 127}));
    connect(manure_bar.y, u1.u1) annotation(
      Line(points = {{-68, 68}, {-56, 68}}, color = {0, 0, 127}));
    connect(tomatopeels_bar.y, u4.u1) annotation(
      Line(points = {{-73, -50}, {-66.5, -50}, {-66.5, -46}, {-60, -46}}, color = {0, 0, 127}));
    connect(u4.y, sAntonio.q[4]) annotation(
      Line(points = {{-36, -52}, {36, -52}, {36, 6}}, color = {0, 0, 127}));
    annotation(
      experiment(StartTime = 0, StopTime = 5.184e+06, Tolerance = 1e-06, Interval = 3600),
      __OpenModelica_commandLineOptions = "--matchingAlgorithm=PFPlusExt --indexReductionMethod=dynamicStateSelection -d=initialization,NLSanalyticJacobian --std=latest ",
      __OpenModelica_simulationFlags(lv = "LOG_STATS", s = "dassl", variableFilter = ".*"),
      Diagram(coordinateSystem(extent = {{-100, -100}, {100, 100}})));
  end SAntonio_OL;

